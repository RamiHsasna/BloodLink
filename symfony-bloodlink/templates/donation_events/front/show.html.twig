{% set page_title = entry.name %}
{% set page_description = 'Review the full event schedule, location, and collection focus before going to the hospital.' %}
{% extends 'dashboard/layouts/front_office.html.twig' %}

{% block extra_head_assets %}
    <link rel="stylesheet" href="{{ asset('styles/donation-events.css') }}">
{% endblock %}

{% block page_actions %}
    <a href="{{ path('dashboard_donor_events') }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">Back to events</a>
{% endblock %}

{% block module_content %}
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
        <section class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
            <div class="grid gap-5 md:grid-cols-2">
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Status</p>
                    <p class="mt-3"><span class="event-status event-status--{{ entry.status|lower }}">{{ entry.status }}</span></p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Hospital</p>
                    <p class="mt-3 text-lg font-bold text-slate-950">{{ entry.hospital ? entry.hospital.name : 'No hospital attached' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 md:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Schedule</p>
                    <p class="mt-3 text-lg font-bold text-slate-950">{{ entry.startDate ? entry.startDate|date('Y-m-d H:i') : 'N/A' }} → {{ entry.endDate ? entry.endDate|date('Y-m-d H:i') : 'N/A' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Location</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.location ?: 'Ask the hospital for the exact collection point.' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Target Blood Types</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.targetBloodTypes ?: 'Open to all compatible donors' }}</p>
                    {% if blood_type_match %}
                        <p class="mt-2 text-sm font-semibold text-blood-600">This event explicitly matches your blood type: {{ donor_blood_type }}</p>
                    {% elseif donor_blood_type %}
                        <p class="mt-2 text-sm text-slate-500">Your blood type: {{ donor_blood_type }}</p>
                    {% endif %}
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Collection Goal</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.actualCollectionUnits ?: 0 }} / {{ entry.targetCollectionUnits ?: 'N/A' }} units</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Hospital Contact</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.hospital and entry.hospital.phone ? entry.hospital.phone : 'No phone available' }}</p>
                    <p class="mt-1 text-sm text-slate-500">{{ entry.hospital and entry.hospital.email ? entry.hospital.email : 'No email available' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 md:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Description</p>
                    <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-600">{{ entry.description ?: 'No extra donor-facing description was provided for this event.' }}</p>
                </div>
            </div>

                {# PARTICIPATE BUTTON: Only show if not already participating #}
                {% if not already_participating and session_user and session_user.user_type == 'DONOR' %}
                <div class="md:col-span-2 flex justify-center mt-6">
                    <form method="post" action="{{ path('donation_events_participate', {'id': entry.eventId}) }}">
                        <button type="submit" class="px-6 py-3 rounded-2xl bg-blood-600 text-white font-bold text-lg shadow hover:bg-blood-700 transition">
                            Participate
                        </button>
                    </form>
                </div>
                {% endif %}
        </section>

        <aside class="event-front-aside">
            <div class="event-front-aside-card">
                <p class="event-form-kicker">Donor Guidance</p>
                <h2 class="event-form-title">Before you go</h2>
                <ul class="event-form-list">
                    <li>Verify the event is still active or planned before travelling.</li>
                    <li>Bring an ID and follow the hospital instructions on arrival.</li>
                    <li>Stay hydrated and eat properly before donation day.</li>
                    <li>Contact the hospital if you need to confirm the exact collection room.</li>
                </ul>
            </div>

            <div class="event-form-reference">
                <strong>Linked donations</strong>
                {{ donation_count }}
            </div>
        </aside>
    </div>
{% endblock %}
