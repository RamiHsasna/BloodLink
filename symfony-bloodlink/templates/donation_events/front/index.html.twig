{% set page_title = 'Donation Events' %}
{% set page_description = 'Browse upcoming collection campaigns, check whether they match your donor profile, and review the event details before you go.' %}
{% extends 'dashboard/layouts/front_office.html.twig' %}

{% block extra_head_assets %}
    <link rel="stylesheet" href="{{ asset('styles/donation-events.css') }}">
{% endblock %}

{% block module_content %}
    <div class="grid gap-4 lg:grid-cols-3">
        {% for card in summary_cards %}
            <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">{{ card.label }}</p>
                <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{{ card.value }}</p>
                <p class="mt-2 text-sm text-slate-500">{{ card.caption }}</p>
            </article>
        {% endfor %}
    </div>

    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
        <section class="space-y-4">
            {% for entry in entries %}
                {% set matches_blood_type = donor_blood_type and entry.targetBloodTypes and donor_blood_type|lower in entry.targetBloodTypes|lower %}
                <article class="event-card">
                    <div class="event-card-main">
                        <div class="event-card-head">
                            <div>
                                <p class="event-card-kicker">{{ entry.hospital ? entry.hospital.name : 'Hospital not available' }}</p>
                                <h2 class="event-card-title">{{ entry.name }}</h2>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                {% if matches_blood_type %}
                                    <span class="event-match-pill">Matches {{ donor_blood_type }}</span>
                                {% endif %}
                                <span class="event-status event-status--{{ entry.status|lower }}">{{ entry.status }}</span>
                            </div>
                        </div>

                        <div class="event-card-meta">
                            <span>{{ entry.startDate ? entry.startDate|date('Y-m-d H:i') : 'No start date' }}</span>
                            <span>→</span>
                            <span>{{ entry.endDate ? entry.endDate|date('Y-m-d H:i') : 'No end date' }}</span>
                        </div>

                        <div class="event-card-grid">
                            <div>
                                <p class="event-card-label">Location</p>
                                <p class="event-card-value">{{ entry.location ?: 'Hospital collection area' }}</p>
                            </div>
                            <div>
                                <p class="event-card-label">Target Blood Types</p>
                                <p class="event-card-value">{{ entry.targetBloodTypes ?: 'Open to all compatible donors' }}</p>
                            </div>
                            <div>
                                <p class="event-card-label">Target Units</p>
                                <p class="event-card-value">{{ entry.targetCollectionUnits ?: 'N/A' }}</p>
                            </div>
                            <div>
                                <p class="event-card-label">Linked Donations</p>
                                <p class="event-card-value">{{ donation_counts[entry.eventId]|default(0) }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="event-card-actions">
                        <a href="{{ path('dashboard_donor_events_show', {eventId: entry.eventId}) }}" class="event-action-link">Open detail</a>
                    </div>
                </article>
            {% else %}
                <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center text-sm text-slate-500">
                    No donation events are currently visible from the donor side.
                </div>
            {% endfor %}
        </section>

        <aside class="event-front-aside">
            <div class="event-front-aside-card">
                <p class="event-form-kicker">Donor Note</p>
                <h2 class="event-form-title">How to use this page</h2>
                <ul class="event-form-list">
                    <li>Open the event detail before heading to the hospital.</li>
                    <li>Check the schedule and target blood-type focus.</li>
                    <li>Use the hospital contact details to confirm attendance if needed.</li>
                    <li>This view is informative only, so no donor-side management actions appear here.</li>
                </ul>
            </div>
        </aside>
    </div>
{% endblock %}
