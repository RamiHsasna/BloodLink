{% set page_title = 'Donation Events' %}
{% set page_description = 'Manage donor-facing collection campaigns, keep hospital ownership clear, and review event activity from one Back Office workspace.' %}
{% extends 'dashboard/layouts/back_office.html.twig' %}

{% block extra_head_assets %}
    <link rel="stylesheet" href="{{ asset('styles/donation-events.css') }}">
{% endblock %}

{% block page_actions %}
    <a href="{{ path('dashboard_events_new') }}" class="inline-flex items-center justify-center rounded-2xl bg-blood-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blood-700">New Event</a>
{% endblock %}

{% block module_content %}
    <div class="grid gap-4 lg:grid-cols-4">
        {% for card in summary_cards %}
            <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">{{ card.label }}</p>
                <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{{ card.value }}</p>
                <p class="mt-2 text-sm text-slate-500">{{ card.caption }}</p>
            </article>
        {% endfor %}
    </div>

    <form method="get" action="{{ path('dashboard_events_index') }}" class="event-filter-card mt-6">
        <div class="event-filter-head">
            <div>
                <p class="event-filter-kicker">Campaign Filters</p>
                <p class="event-filter-copy">Search by title, location, hospital, or blood-type focus. Hospital staff automatically stays inside the event scope of their own hospital.</p>
            </div>
        </div>

        <div class="event-filter-grid">
            <label class="event-filter-field event-filter-field--search">
                <span class="event-filter-label">Search</span>
                <input type="text" name="q" value="{{ filters.q }}" placeholder="Search title, hospital, location, or blood types..." class="event-filter-input">
            </label>

            <label class="event-filter-field">
                <span class="event-filter-label">Status</span>
                <select name="status" class="event-filter-input">
                    <option value="">All statuses</option>
                    {% for choice_label, choice_value in status_choices %}
                        <option value="{{ choice_value }}" {% if filters.status == choice_value %}selected{% endif %}>{{ choice_label }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        <div class="event-filter-actions">
            <button type="submit" class="event-filter-submit">Apply</button>
            <a href="{{ path('dashboard_events_index') }}" class="event-filter-reset">Reset</a>
        </div>
    </form>

    <div class="mt-6 space-y-4">
        {% for entry in entries %}
            <article class="event-card">
                <div class="event-card-main">
                    <div class="event-card-head">
                        <div>
                            <p class="event-card-kicker">{{ entry.hospital ? entry.hospital.name : 'No hospital attached' }}</p>
                            <h2 class="event-card-title">{{ entry.name }}</h2>
                        </div>
                        <span class="event-status event-status--{{ entry.status|lower }}">{{ entry.status }}</span>
                    </div>

                    <div class="event-card-meta">
                        <span>{{ entry.startDate ? entry.startDate|date('Y-m-d H:i') : 'No start date' }}</span>
                        <span>→</span>
                        <span>{{ entry.endDate ? entry.endDate|date('Y-m-d H:i') : 'No end date' }}</span>
                    </div>

                    <div class="event-card-grid">
                        <div>
                            <p class="event-card-label">Location</p>
                            <p class="event-card-value">{{ entry.location ?: 'No specific location provided' }}</p>
                        </div>
                        <div>
                            <p class="event-card-label">Target Blood Types</p>
                            <p class="event-card-value">{{ entry.targetBloodTypes ?: 'Open to all compatible donors' }}</p>
                        </div>
                        <div>
                            <p class="event-card-label">Target Units</p>
                            <p class="event-card-value">{{ entry.targetCollectionUnits ?: 'N/A' }}</p>
                        </div>
                        <div>
                            <p class="event-card-label">Linked Donations</p>
                            <p class="event-card-value">{{ donation_counts[entry.eventId]|default(0) }}</p>
                        </div>
                    </div>
                </div>

                <div class="event-card-actions">
                    <a href="{{ path('dashboard_events_show', {eventId: entry.eventId}) }}" class="event-action-link">View</a>
                    <a href="{{ path('dashboard_events_edit', {eventId: entry.eventId}) }}" class="event-action-link">Edit</a>
                </div>
            </article>
        {% else %}
            <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center text-sm text-slate-500">
                No donation events match the current filters.
            </div>
        {% endfor %}
    </div>

    {% include 'shared/_pagination.html.twig' with {pagination: result, route_name: 'dashboard_events_index', extra_query: {q: filters.q, status: filters.status}} %}
{% endblock %}
