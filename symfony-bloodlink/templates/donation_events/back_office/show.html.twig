{% set page_title = entry.name %}
{% set page_description = 'Inspect the campaign schedule, hospital ownership, donor-facing details, and current collection numbers.' %}
{% extends 'dashboard/layouts/back_office.html.twig' %}

{% block extra_head_assets %}
    <link rel="stylesheet" href="{{ asset('styles/donation-events.css') }}">
{% endblock %}

{% block page_actions %}
    <div class="flex flex-wrap gap-3">
        <a href="{{ path('dashboard_events_edit', {eventId: entry.eventId}) }}" class="inline-flex items-center justify-center rounded-2xl bg-blood-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blood-700">Edit</a>
        <form method="post" action="{{ path('dashboard_events_delete', {eventId: entry.eventId}) }}" data-confirm-message="Delete this donation event?">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-donation-event-' ~ entry.eventId) }}">
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-rose-200 px-4 py-3 text-sm font-semibold text-rose-600 transition hover:border-rose-400 hover:bg-rose-50">Delete</button>
        </form>
        <a href="{{ path('dashboard_events_index') }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">Back</a>
    </div>
{% endblock %}

{% block module_content %}
    <div class="grid gap-6 2xl:grid-cols-[minmax(0,1fr)_340px]">
        <section class="space-y-6">
            <div class="grid gap-5 lg:grid-cols-2">
                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Status</p>
                    <p class="mt-3"><span class="event-status event-status--{{ entry.status|lower }}">{{ entry.status }}</span></p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Hosting Hospital</p>
                    <p class="mt-3 break-words text-lg font-bold leading-8 text-slate-950">{{ entry.hospital ? entry.hospital.name : 'No hospital attached' }}</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 lg:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Schedule</p>
                    <p class="mt-3 text-lg font-bold leading-8 text-slate-950">{{ entry.startDate ? entry.startDate|date('Y-m-d H:i') : 'N/A' }} → {{ entry.endDate ? entry.endDate|date('Y-m-d H:i') : 'N/A' }}</p>
                </div>
            </div>

            <div class="grid gap-5 xl:grid-cols-2">
                <div class="rounded-3xl border border-slate-200 bg-white p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Location</p>
                    <p class="mt-3 break-words text-base font-bold leading-7 text-slate-950">{{ entry.location ?: 'No specific location provided' }}</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-white p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Target Blood Types</p>
                    <p class="mt-3 break-words text-base font-bold leading-7 text-slate-950">{{ entry.targetBloodTypes ?: 'Open to all compatible donors' }}</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-white p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Target Units</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.targetCollectionUnits ?: 'N/A' }}</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-white p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Collected Units</p>
                    <p class="mt-3 text-base font-bold text-slate-950">{{ entry.actualCollectionUnits ?: 'N/A' }}</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-white p-6 xl:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Description</p>
                    <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-600">{{ entry.description ?: 'No donor-facing description was added to this event yet.' }}</p>
                </div>
            </div>
        </section>

        <aside class="self-start rounded-3xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blood-600">Event details</p>
            <dl class="mt-4 space-y-4 text-sm text-slate-600">
                <div>
                    <dt class="font-semibold text-slate-900">Linked donations</dt>
                    <dd class="mt-1">{{ donation_count }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Coordinates</dt>
                    <dd class="mt-1">{{ entry.latitude ?: 'N/A' }} / {{ entry.longitude ?: 'N/A' }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Created at</dt>
                    <dd class="mt-1">{{ entry.createdAt ? entry.createdAt|date('Y-m-d H:i') : 'N/A' }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Updated at</dt>
                    <dd class="mt-1">{{ entry.updatedAt ? entry.updatedAt|date('Y-m-d H:i') : 'N/A' }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Event UUID</dt>
                    <dd class="mt-1 break-all">{{ entry.eventId }}</dd>
                </div>
            </dl>
        </aside>
    </div>
{% endblock %}
