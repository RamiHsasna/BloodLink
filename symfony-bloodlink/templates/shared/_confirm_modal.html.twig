<div class="bo-confirm" data-confirm-modal hidden>
    <div class="bo-confirm-backdrop" data-confirm-backdrop></div>
    <div class="bo-confirm-panel" role="dialog" aria-modal="true" aria-labelledby="bo-confirm-title">
        <div class="bo-confirm-head">
            <p class="bo-confirm-kicker">Confirm action</p>
            <h2 class="bo-confirm-title" id="bo-confirm-title">Delete record</h2>
        </div>

        <div class="bo-confirm-body">
            <p class="bo-confirm-copy" data-confirm-copy>Confirm this action.</p>

            <div class="bo-confirm-actions">
                <button type="button" class="shared-button shared-button--secondary" data-confirm-cancel>Cancel</button>
                <button type="button" class="shared-button shared-button--danger" data-confirm-submit>Delete</button>
            </div>
        </div>
    </div>
</div>
