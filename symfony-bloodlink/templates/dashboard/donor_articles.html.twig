{% set page_title = 'Donor Articles' %}
{% set page_description = 'Trusted updates and practical stories from the donor network.' %}
{% extends 'log_management/layouts/front_office.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
<style>
    :root {
        --bg: #f1f3f7;
        --panel: #ffffff;
        --ink: #0f172a;
        --subtle: #64748b;
        --line: #e2e8f0;
    }

    body { margin: 0; font-family: "Manrope", "Segoe UI", "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: var(--ink); }
    .shell { min-height: 100vh; display: grid; grid-template-columns: 260px 1fr; }

    .sidebar {
        background: linear-gradient(180deg, #0b1736 0%, #08112a 100%);
        color: #e2e8f0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #1e2d5b;
        position: relative;
        overflow: hidden;
    }
    .sidebar::after {
        content: "";
        position: absolute;
        inset: auto -120px -130px auto;
        width: 260px;
        height: 260px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(239, 68, 68, 0.2) 0%, rgba(239, 68, 68, 0) 72%);
        pointer-events: none;
    }
    .brand { padding: 22px 18px; border-bottom: 1px solid #22315f; }
    .brand-row { display: flex; align-items: center; gap: 10px; }
    .brand-logo {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(239, 68, 68, 0.35);
    }
    .brand h2 { margin: 0; font-size: 25px; color: #fff; font-weight: 800; letter-spacing: -0.02em; }
    .brand p { margin: 3px 0 0; color: #93a6d6; font-size: 12px; font-weight: 600; }
    .menu { padding: 16px 12px 10px; display: grid; gap: 8px; }
    .menu-label { margin: 0 0 2px; padding: 0 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #8fa0ce; font-weight: 700; }
    .menu a {
        text-decoration: none;
        color: #c8d3f3;
        padding: 11px 12px;
        border-radius: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid transparent;
        transition: background .2s ease, border-color .2s ease, transform .2s ease;
    }
    .menu .ico {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        border: 1px solid #2f4378;
        background: #0f1f47;
        color: #a9b9e4;
        font-size: 12px;
        display: grid;
        place-items: center;
        font-weight: 800;
        flex-shrink: 0;
    }
    .menu a.active {
        background: linear-gradient(135deg, #1c2e5c, #162650);
        color: #fff;
        border: 1px solid #2b3f74;
    }
    .menu a:hover { background: #16254d; border-color: #2f4378; transform: translateX(2px); }

    .quick-card {
        margin: 0 14px 14px;
        border: 1px solid #2a3d70;
        background: linear-gradient(160deg, rgba(26, 39, 77, 0.95), rgba(14, 27, 61, 0.98));
        border-radius: 14px;
        padding: 12px;
    }
    .quick-card .k { margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #8fa0ce; font-weight: 700; }
    .quick-card .v { margin: 6px 0 0; color: #fff; font-size: 14px; font-weight: 800; }
    .quick-card.good { border-color: rgba(16, 185, 129, 0.5); }
    .quick-card.bad { border-color: rgba(239, 68, 68, 0.5); }

    .profile { margin-top: auto; padding: 14px; border-top: 1px solid #22315f; }
    .profile-card { border: 1px solid #2a3d70; background: #0d1b3e; border-radius: 14px; padding: 12px; }
    .profile-top { display: flex; align-items: center; gap: 9px; margin-bottom: 10px; }
    .profile-avatar {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        background: linear-gradient(135deg, #334155, #1e293b);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 12px;
    }
    .profile .name { margin: 0; font-size: 13px; color: #fff; font-weight: 700; }
    .profile .role { margin: 2px 0 0; color: #8fa0ce; font-size: 11px; }
    .logout-btn { width: 100%; height: 34px; border: 1px solid #374d83; background: #101f45; color: #dbe5ff; border-radius: 9px; font-weight: 700; }

    .main {
        padding: 22px;
        background:
            radial-gradient(circle at 10% 15%, rgba(239, 68, 68, 0.09), transparent 35%),
            radial-gradient(circle at 90% 8%, rgba(59, 130, 246, 0.08), transparent 32%),
            linear-gradient(180deg, #f8fafc 0%, #f4f6fb 100%);
    }
    .head {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 12px;
    }
    .head h1 { margin: 0; font-size: 30px; letter-spacing: -0.02em; }
    .head p { margin: 6px 0 0; color: #475569; }

    .article-list { display: grid; gap: 12px; }
    .article {
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 16px;
        padding: 14px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
    }
    .meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }
    .tag {
        border-radius: 999px;
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #9f1239;
        padding: 3px 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 10px;
    }
    .article h3 { margin: 0; font-size: 20px; line-height: 1.3; }
    .article p { margin: 8px 0 0; color: #475569; line-height: 1.5; }
    .author { margin-top: 10px; color: #334155; font-size: 12px; font-weight: 700; }

    @media (max-width: 980px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { border-right: 0; border-bottom: 1px solid #1e2d5b; }
        .menu { grid-template-columns: 1fr 1fr; }
        .menu-label { grid-column: 1 / -1; }
        .main { padding: 14px; }
    }
</style>
{% endblock %}

{% block module_content %}
<main class="main">
        <section class="head">
            <h1>Latest Articles</h1>
            <p>Trusted updates and practical stories from the donor network.</p>
        </section>

        <section class="article-list">
            {% for article in articles %}
                <article class="article">
                    <div class="meta-row">
                        <span>{{ article.published_at }} • {{ article.read_time }}</span>
                        <span class="tag">{{ article.category }}</span>
                    </div>
                    <h3>{{ article.title }}</h3>
                    <p>{{ article.excerpt }}</p>
                    <p class="author">By {{ article.author }}</p>
                </article>
            {% endfor %}
        </section>
    </main>
{% endblock %}
