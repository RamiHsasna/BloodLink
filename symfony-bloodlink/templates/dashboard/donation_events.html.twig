<script>
// ── Blood type sync ───────────────────────────────────────────────────────────
function syncBloodTypes(prefix) {
    const checks = document.querySelectorAll(`input[name="blood_types[]"]:checked`);
    const hidden = document.getElementById(prefix === 'c' ? 'c-bt-hidden' : 'e-bt-hidden');
    const vals = Array.from(checks).filter(c => c.id.startsWith(prefix + '-bt-')).map(c => c.value);
    hidden.value = vals.join(', ');
}

// ── Date validation ───────────────────────────────────────────────────────────
function validateDates(startId, endId, errorId) {
    const s = document.getElementById(startId).value;
    const e = document.getElementById(endId).value;
    const err = document.getElementById(errorId);
    if (s && e) {
        const diff = (new Date(e) - new Date(s)) / 1000;
        if (diff < 43200) {
            document.getElementById(endId).classList.add('error');
            err.textContent = '⚠ Event must last at least 12 hours. Please choose a later end date.';
            err.style.display = 'block';
            return false;
        }
    } else if (s && !e) {
        document.getElementById(endId).classList.add('error');
        err.textContent = '⚠ Please select an end date and time.';
        err.style.display = 'block';
        return false;
    }
    document.getElementById(endId).classList.remove('error');
    err.style.display = 'none';
    return true;
}

// ── Create modal ──────────────────────────────────────────────────────────────
function openCreate() {
    // Reset form fields every time modal opens
    document.getElementById('create-form').reset();
    document.getElementById('c-start').value = '';
    document.getElementById('c-end').value = '';
    document.getElementById('c-start').min = todayStr;
    document.getElementById('c-end').min = '';
    document.getElementById('c-end-error').style.display = 'none';
    document.getElementById('c-end').classList.remove('error');
    // Uncheck all blood types
    document.querySelectorAll('[id^="c-bt-"]').forEach(cb => { if(cb.type==='checkbox') cb.checked = false; });
    document.getElementById('modal-create').classList.add('open');
}
function closeCreate() { document.getElementById('modal-create').classList.remove('open'); }
document.getElementById('c-end').addEventListener('change', () => validateDates('c-start','c-end','c-end-error'));
document.getElementById('create-form').addEventListener('submit', e => {
    syncBloodTypes('c');
    if (!validateDates('c-start','c-end','c-end-error')) e.preventDefault();
});

// ── Edit modal ────────────────────────────────────────────────────────────────
function openEdit(ev) {
    document.getElementById('edit-form').action = '/dashboard/donation-events/' + ev.event_id + '/edit';
    document.getElementById('edit-name').value        = ev.name ?? '';
    document.getElementById('edit-description').value = ev.description ?? '';
    document.getElementById('edit-location').value    = ev.location ?? '';
    document.getElementById('edit-target').value      = ev.target_collection_units ?? '';
    document.getElementById('edit-hospital').value    = ev.hospital_id ?? '';
    if (ev.start_date) document.getElementById('edit-start').value = ev.start_date.replace(' ','T').substring(0,16);
    if (ev.end_date)   document.getElementById('edit-end').value   = ev.end_date.replace(' ','T').substring(0,16);

    // Set blood type checkboxes
    const selected = (ev.target_blood_types ?? '').split(',').map(s => s.trim());
    document.querySelectorAll('[id^="e-bt-"]').forEach(cb => {
        if (cb.type === 'checkbox') cb.checked = selected.includes(cb.value);
    });

    document.getElementById('modal-edit').classList.add('open');
}
function closeEdit() { document.getElementById('modal-edit').classList.remove('open'); }
document.getElementById('edit-end').addEventListener('change', () => validateDates('edit-start','edit-end','e-end-error'));
document.getElementById('edit-form').addEventListener('submit', e => {
    syncBloodTypes('e');
    if (!validateDates('edit-start','edit-end','e-end-error')) e.preventDefault();
});

// ── Cancel modal ──────────────────────────────────────────────────────────────
function openCancel(eventId, eventName) {
    document.getElementById('cancel-form').action = '/dashboard/donation-events/' + eventId + '/cancel';
    document.getElementById('cancel-event-name').textContent = eventName;
    document.getElementById('cancel-reason').value = '';
    document.getElementById('modal-cancel').classList.add('open');
}
function closeCancel() { document.getElementById('modal-cancel').classList.remove('open'); }

// ── Participants modal ───────────────────────────────────────────────────────
async function openParticipants(eventId, eventName) {
    document.getElementById('participants-event-name').textContent = eventName;
    document.getElementById('participants-count').textContent = 'Loading participants...';
    document.getElementById('participants-table').style.display = 'none';
    document.getElementById('participants-empty').style.display = 'none';
    document.getElementById('participants-body').innerHTML = '';
    document.getElementById('modal-participants').classList.add('open');

    try {
        const response = await fetch('/dashboard/donation-events/' + eventId + '/participants', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });

        if (!response.ok) {
            let errorText = 'Could not load participants.';
            try {
                const err = await response.json();
                if (err && err.error) {
                    errorText = 'Could not load participants: ' + err.error;
                }
            } catch (_) {
                // Keep default fallback message
            }
            document.getElementById('participants-count').textContent = errorText;
            return;
        }

        const payload = await response.json();
        const rows = payload.participants || [];
        document.getElementById('participants-count').textContent = rows.length + ' participant(s)';

        if (rows.length === 0) {
            document.getElementById('participants-empty').style.display = 'block';
            return;
        }

        const body = document.getElementById('participants-body');
        rows.forEach((p) => {
            const tr = document.createElement('tr');
            const name = (p.first_name || '') + ' ' + (p.last_name || '');
            const joinedAt = p.joined_at ? new Date(p.joined_at).toLocaleString() : 'N/A';
            const eligStatus = p.eligibility_status || 'N/A';
            const validUntil = p.valid_until ? new Date(p.valid_until).toLocaleDateString() : 'N/A';
            const statusColor = (eligStatus === 'PENDING') ? '#f59e0b' : (eligStatus === 'ELIGIBLE' || eligStatus === 'APPROVED') ? '#10b981' : '#ef4444';
            
            // Add data attributes for eligibility data
            tr.setAttribute('data-user-id', p.user_id || '');
            tr.setAttribute('data-blood-type-cache', p.blood_type_cache || '');
            tr.setAttribute('data-is-currently-eligible', p.is_currently_eligible ? '1' : '0');
            tr.setAttribute('data-days-until-eligible', p.days_until_eligible || '');
            tr.setAttribute('data-last-calculated-at', p.last_calculated_at ? new Date(p.last_calculated_at).toISOString().split('T')[0] : '');
            tr.setAttribute('data-city', p.donor_city || '');
            tr.setAttribute('data-eligibility-details', p.eligibility_details || '');
            
            tr.innerHTML = `
                <td>${name.trim() || 'N/A'}</td>
                <td>${p.email || 'N/A'}</td>
                <td>${p.phone || 'N/A'}</td>
                <td>${p.blood_type || 'N/A'}</td>
                <td><span style="background:${statusColor};color:white;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;">${eligStatus}</span></td>
                <td>${validUntil}</td>
                <td>${joinedAt}</td>
                <td style="display:flex;gap:4px;flex-wrap:wrap;">
                    <button style="padding:4px 8px;background:#3b82f6;color:white;border:none;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer;" onclick="openReportModal('${payload.event.id}', '${p.user_id}', '${name.trim()}')">View</button>
                    <button style="padding:4px 8px;background:#8b5cf6;color:white;border:none;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer;" onclick="openEligibilityEditModal(this)">Modify</button>
                </td>
            `;
            body.appendChild(tr);
        });

        document.getElementById('participants-table').style.display = 'table';
    } catch (_) {
        document.getElementById('participants-count').textContent = 'Network error while loading participants.';
    }
}

function closeParticipants() {
    document.getElementById('modal-participants').classList.remove('open');
}

// ── Eligibility Report modal ─────────────────────────────────────────────────
async function openReportModal(eventId, userId, donorName) {
    document.getElementById('report-donor-name').textContent = donorName;
    document.getElementById('modal-report').classList.add('open');

    try {
        const url = '/dashboard/eligibility-report/' + eventId + '/' + userId;
        console.log('🔍 Fetching report from:', url);
        
        const response = await fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });

        console.log('📊 Response status:', response.status);

        if (!response.ok) {
            const err = await response.json().catch(() => ({ error: 'Unknown error' }));
            const msg = 'Error: ' + (err.error || 'Status ' + response.status);
            document.getElementById('report-questionnaire').textContent = msg;
            console.error('❌ Failed to fetch report:', msg);
            return;
        }

        const report = await response.json();
        console.log('✅ Full report data:', JSON.stringify(report, null, 2));
        console.log('📋 Eligibility details:', report.eligibility_details);
        console.log('📋 Questionnaire:', report.questionnaire);
        console.log('📝 Doctor Notes:', report.doctor_notes);
        console.log('🔖 Status:', report.status);

        const status = report.status || 'N/A';
        const statusColor = (status === 'PENDING') ? '#f59e0b' : (status === 'ELIGIBLE' || status === 'APPROVED') ? '#10b981' : '#ef4444';

        document.getElementById('report-status').textContent = status;
        document.getElementById('report-status').style.background = statusColor;
        document.getElementById('report-blood-type').textContent = report.blood_type || 'N/A';
        document.getElementById('report-valid-until').textContent = report.valid_until ? new Date(report.valid_until).toLocaleDateString() : 'N/A';

        // Display the real eligibility details text from donor_eligibility
        const eligibilityDetails = report.eligibility_details;
        if (eligibilityDetails && typeof eligibilityDetails === 'string' && eligibilityDetails.trim()) {
            console.log('📝 Eligibility details length:', eligibilityDetails.length);
            document.getElementById('report-questionnaire').innerHTML = '<pre style="white-space:pre-wrap;margin:0;font-family:inherit;">' + eligibilityDetails.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</pre>';
        } else {
            const questionnaire = report.questionnaire;
            if (questionnaire && typeof questionnaire === 'object' && Object.keys(questionnaire).length > 0) {
                console.log('📊 Questionnaire is object with', Object.keys(questionnaire).length, 'keys');
                const q = Object.entries(questionnaire)
                    .map(([k, v]) => `<strong>${k}:</strong> ${v}`)
                    .join('<br>');
                document.getElementById('report-questionnaire').innerHTML = q;
            } else if (questionnaire && typeof questionnaire === 'string' && questionnaire.trim()) {
                console.log('📝 Questionnaire is string:', questionnaire);
                document.getElementById('report-questionnaire').textContent = questionnaire;
            } else {
                console.log('⚠️ No questionnaire data found');
                document.getElementById('report-questionnaire').textContent = 'No questionnaire data available';
            }
        }

        // Display doctor notes
        const doctorNotes = report.doctor_notes;
        if (doctorNotes && typeof doctorNotes === 'string' && doctorNotes.trim()) {
            console.log('🔍 Doctor notes found, length:', doctorNotes.length);
            document.getElementById('report-doctor-notes').textContent = doctorNotes;
        } else {
            console.log('⚠️ No doctor notes found');
            document.getElementById('report-doctor-notes').textContent = 'No assessment reasons available';
        }

        // Display disqualifying reasons
        const disqualifying = report.disqualifying_reasons;
        if (disqualifying && Array.isArray(disqualifying)) {
            document.getElementById('report-disqualifying').innerHTML = disqualifying.length > 0 ? disqualifying.join('<br>') : 'None';
        } else if (disqualifying && typeof disqualifying === 'object') {
            const d = Object.values(disqualifying).filter(v => v).join(', ');
            document.getElementById('report-disqualifying').textContent = d || 'None';
        } else {
            document.getElementById('report-disqualifying').textContent = 'None';
        }

        document.getElementById('report-qr-token').textContent = report.qr_token ? report.qr_token.substring(0, 64) + '...' : '-';
    } catch (err) {
        const msg = 'Network error: ' + (err.message || 'Unknown');
        document.getElementById('report-questionnaire').textContent = msg;
        console.error('❌ Exception loading report:', err);
    }
}

function closeReportModal() {
    document.getElementById('modal-report').classList.remove('open');
}

// ── Eligibility Edit modal ────────────────────────────────────────────────────
// ── Eligibility Edit modal ────────────────────────────────────────────────────
function prepareEligibilitySubmit(event) {
    const status = document.getElementById('edit-elig-status').value;
    const daysInput = document.getElementById('edit-elig-days');
    const isCurrentlyEligibleField = document.getElementById('edit-elig-is-currently-eligible');
    
    // Validate temporary ineligibility has days
    if (status === 'temporarily_ineligible' && (!daysInput.value || parseInt(daysInput.value) <= 0)) {
        alert('Please enter the number of days until eligible');
        return false;
    }
    
    // Set is_currently_eligible based on status
    if (status === 'eligible') {
        isCurrentlyEligibleField.value = '1';
        daysInput.value = '0';
    } else if (status === 'temporarily_ineligible') {
        isCurrentlyEligibleField.value = '0';
        // days_until_eligible keeps its value
    } else if (status === 'ineligible') {
        isCurrentlyEligibleField.value = '0';
        daysInput.value = '0';
    }
    
    return true; // Allow form submission
}

function toggleDaysField() {
    const status = document.getElementById('edit-elig-status').value;
    const daysField = document.getElementById('days-field');
    const daysInput = document.getElementById('edit-elig-days');
    
    if (status === 'temporarily_ineligible') {
        daysField.style.display = 'block';
        daysInput.required = true;
    } else {
        daysField.style.display = 'none';
        daysInput.required = false;
        daysInput.value = '';
    }
}

function openEligibilityEditModal(button) {
    // Get the table row element
    const row = button.closest('tr');
    if (!row) {
        alert('Error: Could not find participant row');
        return;
    }

    // Extract data from row attributes
    const userId = row.getAttribute('data-user-id');
    const bloodType = row.getAttribute('data-blood-type-cache') || '';
    const isEligible = row.getAttribute('data-is-currently-eligible') === '1';
    const daysUntil = row.getAttribute('data-days-until-eligible') || '';
    const lastDate = row.getAttribute('data-last-calculated-at') || '';
    const city = row.getAttribute('data-city') || '';
    const details = row.getAttribute('data-eligibility-details') || '';
    const donorName = row.querySelector('td').textContent.trim();

    if (!userId) {
        alert('Error: Could not find user ID');
        return;
    }

    // Determine eligibility status value
    let statusValue = 'eligible';
    if (!isEligible) {
        statusValue = daysUntil && parseInt(daysUntil) > 0 ? 'temporarily_ineligible' : 'ineligible';
    }

    // Set form action and populate fields
    document.getElementById('eligibility-edit-form').action = '/dashboard/donor-eligibility/' + userId + '/update';
    document.getElementById('edit-elig-user-id').value = userId;
    document.getElementById('edit-elig-blood-type').value = bloodType;
    document.getElementById('edit-elig-status').value = statusValue;
    document.getElementById('edit-elig-days').value = daysUntil || '';
    document.getElementById('edit-elig-date').value = lastDate;
    document.getElementById('edit-elig-city').value = city;
    document.getElementById('edit-elig-details').value = details;
    document.getElementById('edit-elig-donor-name').textContent = donorName;

    // Toggle days field visibility based on status
    toggleDaysField();

    document.getElementById('modal-eligibility-edit').classList.add('open');
}

function closeEligibilityEdit() {
    document.getElementById('modal-eligibility-edit').classList.remove('open');
}
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
});
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.open').forEach(o => o.classList.remove('open'));
        closeMap();
    }
});

var todayStr = new Date().toISOString().slice(0, 16);
document.getElementById('c-start').min = todayStr;
document.getElementById('c-start').value = '';

document.getElementById('c-start').addEventListener('change', function() {
    const start = new Date(this.value);
    // Auto-set end date to start + 1 day
    const autoEnd = new Date(start.getTime() + 24 * 60 * 60 * 1000);
    const endStr = autoEnd.toISOString().slice(0, 16);
    document.getElementById('c-end').min = this.value;
    document.getElementById('c-end').value = endStr;
    validateDates('c-start', 'c-end', 'c-end-error');
});

// ── MAP ───────────────────────────────────────────────────────────────────────
let leafletMap = null;

async function openMap(eventId, eventName, location) {
    if (!location || location.trim() === '') {
        alert('No location set for this event.\nEdit the event and add a location in the format:\nHôpital X, Ville  or  Banc du sang X, Ville');
        return;
    }

    document.getElementById('map-modal-title').textContent = '📍 ' + eventName;
    document.getElementById('map-location-label').textContent = '🔍 Searching: ' + location;
    document.getElementById('map-not-found').style.display = 'none';
    document.getElementById('map-container').style.display = 'block';
    document.getElementById('map-modal-overlay').classList.add('open');

    if (leafletMap) { leafletMap.remove(); leafletMap = null; }

    leafletMap = L.map('map-container').setView([33.8, 9.5], 6);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(leafletMap);

    try {
        const clean = s => s.replace(/blood bank/gi,'').replace(/banc du sang/gi,'').replace(/collection hall/gi,'').replace(/main lobby/gi,'').replace(/\s+/g,' ').trim();
        const parts = location.split(',');
        const place = clean(parts[0].trim());
        const city  = parts.length > 1 ? parts[parts.length - 1].trim() : '';

        const queries = [
            place + (city ? ', ' + city : '') + ', Tunisia',
            place + (city ? ', ' + city : '') + ', Tunisie',
            location + ', Tunisia',
            location + ', Tunisie',
            place + ', Tunisia',
            city ? city + ', Tunisia' : null,
        ].filter(Boolean);

        let found = null;
        for (const q of queries) {
            const resp = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=1&countrycodes=tn&accept-language=fr`);
            const data = await resp.json();
            if (data.length > 0) { found = data[0]; break; }
            await new Promise(r => setTimeout(r, 300));
        }

        if (found) {
            const lat = parseFloat(found.lat);
            const lon = parseFloat(found.lon);
            leafletMap.setView([lat, lon], 16);
            const redIcon = L.divIcon({
                html: `<div style="background:#dc2626;width:20px;height:20px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.3);"></div>`,
                iconSize: [20,20], iconAnchor: [10,20], className: ''
            });
            L.marker([lat,lon],{icon:redIcon}).addTo(leafletMap)
                .bindPopup(`<div style="font-family:sans-serif;min-width:160px;"><strong style="color:#dc2626;">📍 ${eventName}</strong><br><span style="font-size:12px;color:#6b7280;">${found.display_name}</span></div>`,{maxWidth:280})
                .openPopup();
            document.getElementById('map-location-label').textContent = '📍 ' + found.display_name;
        } else {
            document.getElementById('map-container').style.display = 'none';
            document.getElementById('map-not-found').style.display = 'block';
            document.getElementById('map-not-found').innerHTML = `⚠️ Location not found: <strong>${location}</strong><br><small>Try: Hôpital Fattouma Bourguiba, Monastir</small>`;
        }
    } catch(err) {
        document.getElementById('map-container').style.display = 'none';
        document.getElementById('map-not-found').style.display = 'block';
        document.getElementById('map-not-found').textContent = '⚠️ Network error.';
    }
}

function closeMap() {
    document.getElementById('map-modal-overlay').classList.remove('open');
    if (leafletMap) { leafletMap.remove(); leafletMap = null; }
}

document.getElementById('map-modal-overlay').addEventListener('click', e => {
    if (e.target === document.getElementById('map-modal-overlay')) closeMap();
});
</script>

