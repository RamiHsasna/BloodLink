{% extends 'base.html.twig' %}

{% set body_class = 'fo-page' %}
{% set route = app.request.attributes.get('_route')|default('') %}
{% set session_payload = session_user is defined and session_user ? session_user : (app.session is defined ? app.session.get('auth_user') : null) %}
{% set is_alerts_route = route starts with 'dashboard_donor_alert' %}
{% set is_audit_trail_route = route == 'dashboard_donor_audit_trail' %}
{% set is_events_route = route starts with 'dashboard_donor_events' %}

{% block title %}{{ page_title|default('BloodLink Donor Area') }}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/normalized-ui.css') }}">
    {% block extra_head_assets %}{% endblock %}
    <style>
        .fo-navbar {
            background: #ffffff;
            padding: 16px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .fo-navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .fo-navbar-logo {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #8f1d1f, #b3272a);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            font-weight: 900;
            box-shadow: 0 4px 12px rgba(143,29,31,0.2);
        }

        .fo-navbar-brand-text {
            display: flex;
            flex-direction: column;
        }

        .fo-navbar-brand-name {
            font-size: 24px;
            font-weight: 800;
            color: #1e293b;
            letter-spacing: -0.02em;
            line-height: 1;
            margin: 0;
        }

        .fo-navbar-links {
            display: flex;
            gap: 32px;
        }

        .fo-navbar-link {
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            color: #475569;
            transition: color 0.2s;
        }

        .fo-navbar-link:hover,
        .fo-navbar-link.is-active {
            color: #dc2626;
        }

        .fo-navbar-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .fo-navbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }

        .fo-navbar-avatar {
            width: 32px;
            height: 32px;
            background: #f1f5f9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            font-size: 12px;
        }
        
        .fo-layout {
            display: flex;
            flex-direction: column;
        }
        
        .fo-main-shell {
            padding: 0;
            flex: 1;
        }

        .fo-main-card {
            min-height: calc(100vh - 73px);
            background: #fffdfc;
            border: none;
            border-radius: 0;
            box-shadow: none;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="fo-shell" style="min-height: 100vh; display: flex; flex-direction: column;">
        <header class="fo-navbar">
            <a href="{{ path('dashboard_donor_home') }}" class="fo-navbar-brand">
                <div class="fo-navbar-logo">BL</div>
                <div class="fo-navbar-brand-text">
                    <p class="fo-navbar-brand-name">BloodLink</p>
                </div>
            </a>

            <nav class="fo-navbar-links">
                <a href="{{ path('dashboard_donor_home') }}" class="fo-navbar-link {{ route == 'dashboard_donor_home' ? 'is-active' : '' }}">Home</a>
                <a href="{{ path('dashboard_donor_articles') }}" class="fo-navbar-link {{ route == 'dashboard_donor_articles' ? 'is-active' : '' }}">Blogs</a>
                <a href="{{ path('dashboard_donor_eligibility') }}" class="fo-navbar-link {{ route == 'dashboard_donor_eligibility' ? 'is-active' : '' }}">My Eligibility</a>
                <a href="{{ path('donor_my_donations') }}" class="fo-navbar-link {{ route == 'donor_my_donations' ? 'is-active' : '' }}">My Donations</a>
                <a href="{{ path('dashboard_donor_alerts') }}" class="fo-navbar-link {{ is_alerts_route ? 'is-active' : '' }}" style="position: relative;">
                    Alerts
                    {% if unread_alerts_count is defined and unread_alerts_count > 0 %}
                        <span style="position: absolute; top: -5px; right: -15px; background: #dc2626; color: #fff; font-size: 10px; font-weight: 800; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid #fff;">{{ unread_alerts_count }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('dashboard_donor_events') }}" class="fo-navbar-link {{ is_events_route ? 'is-active' : '' }}">Donate Blood</a>
            </nav>

            <div class="fo-navbar-actions">
                {% if session_payload.user_type == 'DONOR' %}
                    <button type="button" class="shared-button shared-button--primary" onclick="openChat()" style="background:linear-gradient(135deg,#8f1d1f,#b3272a);color:#fff;border:none;box-shadow: 0 4px 12px rgba(143,29,31,0.25); min-height: 36px; height: 36px;">💬 AI Assistant</button>
                {% endif %}
                <div class="fo-navbar-user">
                    <div class="fo-navbar-avatar">{{ session_payload.first_name|first|upper }}{{ session_payload.last_name|first|upper }}</div>
                    <span>{{ session_payload.first_name }}</span>
                </div>
                <form method="post" action="{{ path('auth_logout') }}" style="margin:0;">
                    <button type="submit" class="shared-button shared-button--secondary" style="min-height:36px; padding: 0 12px; font-size: 13px;">Logout</button>
                </form>
            </div>
        </header>

        <div class="fo-layout" style="flex: 1; display: flex; flex-direction: column;">
            <main class="fo-main-shell" style="flex: 1; display: flex; flex-direction: column; padding: 0;">
                <div class="fo-main-card" style="flex: 1; background: #fffdfc; border: none; border-radius: 0; box-shadow: none;">
                    <section class="fo-content" style="padding: 0;">
                        {% include 'shared/_flash.html.twig' %}
                        {% block module_content %}{% endblock %}
                    </section>
                </div>
            </main>
        </div>
    </div>
    {% if session_payload.user_type == 'DONOR' %}
        {% include 'dashboard/partials/_ai_agent.html.twig' %}
    {% endif %}
    {% block extra_body_assets %}{% endblock %}
{% endblock %}
