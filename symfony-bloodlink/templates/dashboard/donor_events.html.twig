{% set page_title = 'Donation Events' %}
{% set page_description = 'View upcoming and active blood donation events near you.' %}
{% extends 'log_management/layouts/front_office.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
    :root { --brand: #8f1d1f; --brand-2: #b3272a; --ok: #10b981; --line: #e2e8f0; --subtle: #64748b; --ink: #0f172a; }
    .flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 14px; }
    .flash.error { background: #fee2e2; color: #991b1b; border-left: 4px solid #dc2626; }
    .events-grid { display: grid; gap: 16px; }
    .event-card { background: white; border: 1px solid var(--line); border-radius: 14px; padding: 24px; transition: all .2s; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .event-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.08); transform: translateY(-2px); }
    .event-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; gap: 12px; flex-wrap: wrap; }
    .event-name { font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .event-dates { font-size: 13px; color: var(--subtle); }
    .badge { display: inline-block; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    .badge-PLANNED { background: #fef3c7; color: #92400e; }
    .badge-ACTIVE  { background: #d1fae5; color: #065f46; }
    .event-details { display: grid; grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); }
    .detail-label { font-size: 10px; font-weight: 700; color: var(--subtle); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 3px; }
    .detail-value { font-size: 14px; font-weight: 600; color: var(--ink); }
    .progress-bar { height: 6px; background: #e5e7eb; border-radius: 4px; overflow: hidden; margin-top: 4px; }
    .progress-fill { height: 100%; background: linear-gradient(90deg,var(--ok),var(--brand)); border-radius: 4px; }
    .empty { text-align: center; padding: 48px; background: white; border: 2px dashed #d1d5db; border-radius: 14px; color: var(--subtle); }
    .empty-icon { font-size: 48px; margin-bottom: 12px; opacity: .5; }

    /* Map modal */
    #map-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.55); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
    #map-modal-overlay.open { display: flex; }
    #map-modal { width: min(700px,96vw); background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    #map-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #e5e7eb; }
    #map-modal-header h3 { margin: 0; font-size: 17px; color: #111827; }
    #map-modal-close { background: none; border: none; font-size: 20px; cursor: pointer; color: #6b7280; padding: 4px 8px; border-radius: 6px; }
    #map-modal-close:hover { background: #f3f4f6; }
    #map-container { height: 420px; width: 100%; }
    #map-not-found { display: none; padding: 40px 20px; text-align: center; color: #6b7280; font-size: 14px; }
    #map-location-label { padding: 10px 20px; font-size: 13px; color: #6b7280; border-top: 1px solid #e5e7eb; background: #f9fafb; }
</style>
{% endblock %}

{% block module_content %}

{% for msg in app.flashes('success') %}<div class="flash" style="background:#dcfce7;color:#166534;border-left:4px solid #16a34a;">{{ msg }}</div>{% endfor %}
{% for msg in app.flashes('error') %}<div class="flash error">{{ msg }}</div>{% endfor %}

{% if events %}
<div class="events-grid">
    {% for event in events %}
    {% set pct = event.target_collection_units > 0 ? ((event.total_donations / event.target_collection_units) * 100) : 0 %}
    <div class="event-card">
        <div class="event-header">
            <div>
                <div class="event-name">{{ event.name }}</div>
                <div class="event-dates">📅 {{ event.start_date|date('M d, Y H:i') }} → {{ event.end_date|date('M d, Y H:i') }}</div>
            </div>
            <span class="badge badge-{{ event.status }}">
                {% if event.status == 'PLANNED' %}📅 Planned{% else %}▶ Active{% endif %}
            </span>
        </div>

        <div class="event-details">
            <div>
                <div class="detail-label">📍 Location</div>
                <div class="detail-value">{{ event.location ?? 'N/A' }}</div>
            </div>
            <div>
                <div class="detail-label">🏥 Hospital</div>
                <div class="detail-value">{{ event.hospital_name ?? 'N/A' }}</div>
            </div>
            <div>
                <div class="detail-label">🎯 Blood Types Needed</div>
                <div class="detail-value">{{ event.target_blood_types ?? 'All types' }}</div>
            </div>
            {% if event.target_collection_units %}
            <div>
                <div class="detail-label">🩸 Collection Goal</div>
                <div class="detail-value">{{ event.target_collection_units }}L</div>
                <div class="progress-bar"><div class="progress-fill" style="width:{{ pct > 100 ? 100 : pct }}%"></div></div>
            </div>
            {% endif %}
        </div>

        {% if event.description %}
        <div style="margin-top:14px;padding:12px 16px;background:#f9fafb;border-left:3px solid var(--brand);border-radius:6px;font-size:13px;color:#374151;line-height:1.6;">
            {{ event.description|slice(0,200) }}{% if event.description|length > 200 %}...{% endif %}
        </div>
        {% endif %}

        <div style="display:flex; gap:10px; align-items:center; margin-top:14px; flex-wrap:wrap;">
            {% if not event.has_joined %}
            <form method="post" action="{{ path('donation_events_participate', {'id': event.event_id}) }}" style="margin:0;">
                <button type="submit" style="background:var(--brand);color:white;border:none;border-radius:10px;padding:10px 16px;font-weight:700;cursor:pointer;font-size:14px;">
                    Participate
                </button>
                <div class="participate-message" style="margin-top:8px;font-weight:600;"></div>
            </form>
            {% else %}
            <div style="font-size:13px;font-weight:700;color:#166534;margin:0;padding:10px 0;">You already joined this event.</div>
            {% endif %}

            <button type="button" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;border-radius:10px;padding:10px 16px;font-weight:700;cursor:pointer;font-size:14px;margin-left:auto;"
                onclick="openMap('{{ event.event_id }}', '{{ event.name|e('js') }}', '{{ (event.location ?? '')|e('js') }}')">
                📍 Map
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="empty">
    <div class="empty-icon">📅</div>
    <h3 style="font-size:18px;font-weight:700;color:var(--ink);margin-bottom:8px;">No Upcoming Events</h3>
    <p style="font-size:14px;">There are no planned or active donation events at this time. Check back soon!</p>
</div>
{% endif %}

<!-- MAP MODAL -->
<div id="map-modal-overlay">
    <div id="map-modal">
        <div id="map-modal-header">
            <h3 id="map-modal-title">📍 Event Location</h3>
            <button id="map-modal-close" onclick="closeMap()" type="button">✕</button>
        </div>
        <div id="map-container"></div>
        <div id="map-not-found">⚠️ Location not found.</div>
        <div id="map-location-label"></div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    let leafletMap = null;

    async function openMap(eventId, eventName, location) {
        if (!location || location.trim() === '') {
            alert('No location set for this event.');
            return;
        }

        document.getElementById('map-modal-title').textContent = '📍 ' + eventName;
        document.getElementById('map-location-label').textContent = '🔍 Searching: ' + location;
        document.getElementById('map-not-found').style.display = 'none';
        document.getElementById('map-container').style.display = 'block';
        document.getElementById('map-modal-overlay').classList.add('open');

        if (leafletMap) { leafletMap.remove(); leafletMap = null; }

        leafletMap = L.map('map-container').setView([33.8, 9.5], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(leafletMap);

        try {
            const clean = s => s.replace(/blood bank/gi,'').replace(/banc du sang/gi,'').replace(/collection hall/gi,'').replace(/main lobby/gi,'').replace(/\s+/g,' ').trim();
            const parts = location.split(',');
            const place = clean(parts[0].trim());
            const city  = parts.length > 1 ? parts[parts.length - 1].trim() : '';

            const queries = [
                place + (city ? ', ' + city : '') + ', Tunisia',
                place + (city ? ', ' + city : '') + ', Tunisie',
                location + ', Tunisia',
                location + ', Tunisie',
                place + ', Tunisia',
                city ? city + ', Tunisia' : null,
            ].filter(Boolean);

            let found = null;
            for (const q of queries) {
                const resp = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=1&countrycodes=tn&accept-language=fr`);
                const data = await resp.json();
                if (data.length > 0) { found = data[0]; break; }
                await new Promise(r => setTimeout(r, 300));
            }

            if (found) {
                const lat = parseFloat(found.lat);
                const lon = parseFloat(found.lon);
                leafletMap.setView([lat, lon], 16);
                const redIcon = L.divIcon({
                    html: `<div style="background:#dc2626;width:20px;height:20px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.3);"></div>`,
                    iconSize: [20,20], iconAnchor: [10,20], className: ''
                });
                L.marker([lat,lon],{icon:redIcon}).addTo(leafletMap)
                    .bindPopup(`<div style="font-family:sans-serif;min-width:160px;"><strong style="color:#dc2626;">📍 ${eventName}</strong><br><span style="font-size:12px;color:#6b7280;">${found.display_name}</span></div>`,{maxWidth:280})
                    .openPopup();
                document.getElementById('map-location-label').textContent = '📍 ' + found.display_name;
            } else {
                document.getElementById('map-container').style.display = 'none';
                document.getElementById('map-not-found').style.display = 'block';
                document.getElementById('map-not-found').innerHTML = `⚠️ Location not found: <strong>${location}</strong>`;
            }
        } catch(err) {
            document.getElementById('map-container').style.display = 'none';
            document.getElementById('map-not-found').style.display = 'block';
            document.getElementById('map-not-found').textContent = '⚠️ Network error.';
        }
    }

    function closeMap() {
        document.getElementById('map-modal-overlay').classList.remove('open');
        if (leafletMap) { leafletMap.remove(); leafletMap = null; }
    }

    document.addEventListener('DOMContentLoaded', function(){
        document.getElementById('map-modal-overlay').addEventListener('click', e => {
            if (e.target === document.getElementById('map-modal-overlay')) closeMap();
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeMap();
        });
        document.querySelectorAll('form[action$="/participate"]').forEach(function(form){
            form.addEventListener('submit', async function(e){
                e.preventDefault();
                const msgEl = form.querySelector('.participate-message');
                if (msgEl) msgEl.textContent = '';
                try {
                    const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } });
                    const json = await res.json();
                    if (msgEl) {
                        msgEl.textContent = json.message || (json.ok ? 'Registered' : 'Error');
                        msgEl.style.color = json.ok ? '#059669' : '#991b1b';
                    }
                    if (json.ok) {
                        const btn = form.querySelector('button[type=submit]');
                        if (btn) { btn.disabled = true; btn.textContent = 'Registered'; }
                    }
                } catch (err) {
                    if (msgEl) { msgEl.textContent = 'Network error'; msgEl.style.color = '#991b1b'; }
                }
            });
        });
    });
    </script>
{% endblock %}