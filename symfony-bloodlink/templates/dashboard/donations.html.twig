<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// ── Donations data for chart ──────────────────────────────────────────────────
const allDonations = {{ donations|json_encode|raw }};

// ── Create modal ──────────────────────────────────────────────────────────────
function openCreate() { document.getElementById('modal-create').classList.add('open'); }
function closeCreate(){ document.getElementById('modal-create').classList.remove('open'); }

function updateDateRange() {
    var sel   = document.getElementById('event-select');
    var opt   = sel.options[sel.selectedIndex];
    var start = opt?.dataset?.start;
    var end   = opt?.dataset?.end;
    var input = document.getElementById('donation-date');
    var hint  = document.getElementById('date-hint');
    if (start && end) {
        input.min   = start;
        input.max   = end;
        input.value = start;
        hint.textContent = 'Must be between ' + start.substring(0,10) + ' and ' + end.substring(0,10);
    } else {
        input.min = ''; input.max = ''; hint.textContent = '';
    }
}

// ── Edit modal ────────────────────────────────────────────────────────────────
window.bl_openEdit = function(d) {
    document.getElementById('edit-form').action = '/dashboard/donations/' + d.donation_id + '/edit';
    document.getElementById('edit-donor-display').value = (d.donor_first_name || '') + ' ' + (d.donor_last_name || '');
    document.getElementById('edit-blood-type').value    = d.blood_type_id || d.blood_code || d.donor_blood_type || '';
    document.getElementById('edit-event').value         = d.donation_event_id || '';
    document.getElementById('edit-hospital').value      = d.hospital_id || '';
    document.getElementById('edit-volume').value        = d.volume_collected || '';
    document.getElementById('edit-status').value        = d.status || 'COMPLETED';
    document.getElementById('edit-notes').value         = d.medical_notes || '';
    document.getElementById('screening-edit').checked   = d.screening_passed === true || d.screening_passed === 't' || d.screening_passed === '1';
    if (d.donation_date) document.getElementById('edit-date').value = d.donation_date.replace(' ','T').substring(0,16);
    document.getElementById('modal-edit').classList.add('open');
};
window.bl_closeEdit = function(){ document.getElementById('modal-edit').classList.remove('open'); };

// ── QR modal ──────────────────────────────────────────────────────────────────
if (typeof window.currentQrData === 'undefined') { window.currentQrData = ''; }
if (typeof window.currentDonationForQr === 'undefined') { window.currentDonationForQr = null; }

window.bl_openQr = function(d) {
    window.currentDonationForQr = d;
    window.bl_updateQrWithOverride();

    document.getElementById('mini-donor-name').textContent = (d.donor_first_name || '') + ' ' + (d.donor_last_name || '');
    document.getElementById('mini-blood-code').textContent = d.blood_code || d.blood_type_id || '—';
    document.getElementById('mini-date').textContent = d.donation_date ? new Date(d.donation_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '—';
    document.getElementById('mini-location').textContent = d.hospital_name || 'Mobile Unit';

    document.getElementById('modal-qr').classList.add('open');
}

window.bl_updateQrWithOverride = function() {
    var d = window.currentDonationForQr;
    if (!d) return;
    
    // Plain text details so it shows up immediately on phone without browser
    window.currentQrData = `BLOODLINK DONATION
--------------------
DONOR: ${(d.donor_first_name || '')} ${(d.donor_last_name || '')}
TYPE: ${d.blood_code || d.blood_type_id || '—'}
DATE: ${d.donation_date ? d.donation_date.substring(0,10) : '—'}
VOL: ${d.volume_collected || '—'} mL
ID: ${d.donation_id.substring(0,8)}`;

    const container = document.getElementById('qr-display');
    if (!container) return;
    
    container.innerHTML = '<div style="font-size:10px;color:#94a3b8">Generating...</div>'; 
    
    setTimeout(() => {
        if (typeof QRCode === 'undefined') {
            container.innerHTML = '<div style="font-size:10px;color:#ef4444">QR Library Error</div>';
            return;
        }
        container.innerHTML = ''; 
        new QRCode(container, {
            text: window.currentQrData,
            width: 180,
            height: 180,
            colorDark: '#0f172a',
            colorLight: '#ffffff'
        });
    }, 150);
};

function downloadCertImage() {
    const cert = document.getElementById('mini-cert-wrapper');
    html2canvas(cert, {
        scale: 2,
        backgroundColor: '#ffffff'
    }).then(canvas => {
        const link = document.createElement('a');
        link.download = 'bloodlink-certificate-' + (currentDonationForQr.donation_id.substring(0,8)) + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
    });
}
function closeQr(){ document.getElementById('modal-qr').classList.remove('open'); }
function saveQr() {
    const container = document.getElementById('qr-display');
    html2canvas(container).then(canvas => {
        const link = document.createElement('a');
        link.download = 'donation-qr.png';
        link.href = canvas.toDataURL();
        link.click();
    });
}

// ── Chart rendering in chat ───────────────────────────────────────────────────
let chartInstance = null;
let chartInstance2 = null;
window.toggleChatCharts = function() {
    const el = document.getElementById('chat-charts');
    if (el.style.display === 'none') {
        el.style.display = 'block';
        setTimeout(() => renderCharts(), 50);
    } else {
        el.style.display = 'none';
    }
};

function renderCharts() {
    // Monthly chart
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const counts = new Array(12).fill(0);
    allDonations.forEach(d => {
        if (d.donation_date) {
            const m = new Date(d.donation_date).getMonth();
            counts[m]++;
        }
    });

    if (chartInstance) chartInstance.destroy();
    const ctx = document.getElementById('donations-chart').getContext('2d');
    chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: months,
            datasets: [{
                label: 'Donations',
                data: counts,
                backgroundColor: 'rgba(143,29,31,0.75)',
                borderColor: '#8f1d1f',
                borderWidth: 1,
                borderRadius: 6,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Blood type chart
    const btCounts = {};
    allDonations.forEach(d => {
        const bt = d.blood_code || d.blood_type_id || 'Unknown';
        btCounts[bt] = (btCounts[bt] || 0) + 1;
    });
    const btLabels = Object.keys(btCounts);
    const btData   = Object.values(btCounts);
    const btColors = ['#dc2626','#16a34a','#2563eb','#d97706','#7c3aed','#0891b2','#db2777','#65a30d'];

    if (chartInstance2) chartInstance2.destroy();
    const ctx2 = document.getElementById('bloodtype-chart').getContext('2d');
    chartInstance2 = new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: btLabels,
            datasets: [{
                data: btData,
                backgroundColor: btColors.slice(0, btLabels.length),
                borderWidth: 2,
                borderColor: '#fff',
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'right' },
                title: { display: true, text: 'Donations by Blood Type', font: { size: 14, weight: '700' } }
            }
        }
    });
}

// ── History modal ─────────────────────────────────────────────────────────────
window.bl_loadHistory = function(userId, name) {
    document.getElementById('history-title').textContent = name + ' — Donation History';
    document.getElementById('history-profile').innerHTML = '<p style="color:var(--subtle)">Loading...</p>';
    document.getElementById('history-list').innerHTML    = '';
    document.getElementById('modal-history').classList.add('open');

    fetch('/dashboard/donations/donor/' + userId + '/history')
        .then(r => r.json())
        .then(data => {
            const donor = data.donor || {};
            document.getElementById('history-profile').innerHTML = `
                <div class="profile-item"><span class="profile-label">Blood Type</span><span class="profile-value">${donor.blood_type_id || '—'}</span></div>
                <div class="profile-item"><span class="profile-label">Total Donations</span><span class="profile-value">${donor.total_donations || 0}</span></div>
                <div class="profile-item"><span class="profile-label">City</span><span class="profile-value">${donor.city || '—'}</span></div>
                <div class="profile-item"><span class="profile-label">Eligible</span><span class="profile-value">${donor.is_currently_eligible ? '✓ Yes' : '✗ No'}</span></div>
                <div class="profile-item"><span class="profile-label">Last Donation</span><span class="profile-value">${donor.last_donation_date ? donor.last_donation_date.substring(0,10) : '—'}</span></div>
                <div class="profile-item"><span class="profile-label">Email</span><span class="profile-value">${donor.email || '—'}</span></div>
            `;

            if (!data.history || !data.history.length) {
                document.getElementById('history-list').innerHTML = '<p style="color:var(--subtle);text-align:center;padding:20px">No donations found.</p>';
                return;
            }

            const now = Date.now();
            document.getElementById('history-list').innerHTML = data.history.map((h, i) => {
                const expired = (now - new Date(h.donation_date).getTime()) / 86400000 > 42;
                return `<div class="history-card ${expired ? 'h-expired' : ''}">
                    <div class="history-card-head">
                        <strong>#${i+1} — ${new Date(h.donation_date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</strong>
                        <div style="display:flex;gap:6px">
                            ${expired ? '<span class="badge badge-expired">⚠ Expired</span>' : ''}
                            <span class="badge badge-${(h.status||'').toLowerCase()}">${h.status || ''}</span>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:13px">
                        <div><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Hospital</span>${h.hospital_name || '—'}</div>
                        <div><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Event</span>${h.event_name || '—'}</div>
                        <div><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Volume</span>${h.volume_collected || '—'} mL</div>
                        <div><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Blood Type</span>${h.blood_code || '—'}</div>
                        <div><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Screening</span>${h.screening_passed ? '✓ Passed' : '✗ Failed'}</div>
                        ${h.medical_notes ? `<div style="grid-column:1/-1"><span style="color:var(--subtle);font-size:10px;text-transform:uppercase;font-weight:700;display:block">Notes</span>${h.medical_notes}</div>` : ''}
                    </div>
                </div>`;
            }).join('');
        })
        .catch(() => {
            document.getElementById('history-list').innerHTML = '<p style="color:var(--danger);text-align:center">Failed to load history.</p>';
        });
}
function closeHistory(){ document.getElementById('modal-history').classList.remove('open'); }

// ── Backdrop & Escape ─────────────────────────────────────────────────────────
document.querySelectorAll('.modal-bg').forEach(bg => {
    bg.addEventListener('click', e => { if (e.target === bg) bg.classList.remove('open'); });
});
</script>
<script>
(function() {

// ── State ──────────────────────────────────────────────────────────────────
let chatHistory = [];
let isBotTyping  = false;

// ── Build stats context from the existing allDonations variable ────────────
function buildStatsContext() {
    const donations = typeof allDonations !== 'undefined' ? allDonations : [];
    const total = donations.length;

    // Blood type breakdown
    const btCounts = {};
    donations.forEach(d => {
        const bt = d.blood_code || d.blood_type_id || 'Unknown';
        btCounts[bt] = (btCounts[bt] || 0) + 1;
    });

    // Status breakdown
    const statusCounts = {};
    donations.forEach(d => {
        const s = d.status || 'Unknown';
        statusCounts[s] = (statusCounts[s] || 0) + 1;
    });

    // Screening
    const screeningPassed = donations.filter(d =>
        d.screening_passed === true || d.screening_passed === 't' || d.screening_passed === '1'
    ).length;

    // Monthly
    const monthlyCounts = {};
    donations.forEach(d => {
        if (d.donation_date) {
            const m = new Date(d.donation_date).toLocaleString('en', { month: 'long', year: 'numeric' });
            monthlyCounts[m] = (monthlyCounts[m] || 0) + 1;
        }
    });

    // Total volume
    const totalVolume = donations.reduce((sum, d) => sum + (parseFloat(d.volume_collected) || 0), 0);

    // Expired (> 42 days)
    const now = Date.now();
    const expiredCount = donations.filter(d =>
        d.donation_date && (now - new Date(d.donation_date).getTime()) / 86400000 > 42
    ).length;

    return `
You are a helpful AI assistant for BloodLink, a blood donation management system.
Answer questions concisely and helpfully. Use bullet points for lists.
When discussing percentages, calculate them from the data provided.

CURRENT DONATION DATABASE STATS:
- Total donations: ${total}
- Blood type distribution: ${JSON.stringify(btCounts)}
- Status breakdown: ${JSON.stringify(statusCounts)}
- Screening passed: ${screeningPassed} of ${total} (${total ? Math.round(screeningPassed/total*100) : 0}%)
- Total volume collected: ${Math.round(totalVolume)} mL
- Expired donations (>42 days old): ${expiredCount}
- Monthly distribution: ${JSON.stringify(monthlyCounts)}

The users asking questions may be hospital staff, donors, or admins.
Keep answers relevant to blood donation management.
When asked about percentages, always calculate them from the data above.
`.trim();
}

// ── DOM helpers ────────────────────────────────────────────────────────────
function messagesEl() { return document.getElementById('chat-messages'); }

function appendMessage(role, text, isHtml = false) {
    const el = messagesEl();
    const div = document.createElement('div');
    div.className = 'msg ' + role;

    const avatar = document.createElement('div');
    avatar.className = 'msg-avatar';
    avatar.textContent = role === 'bot' ? '🤖' : '👤';

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    if (isHtml) {
        bubble.innerHTML = text;
    } else {
        bubble.textContent = text;
    }

    div.appendChild(avatar);
    div.appendChild(bubble);
    el.appendChild(div);
    el.scrollTop = el.scrollHeight;
    return bubble;
}

function appendTyping() {
    const el = messagesEl();
    const div = document.createElement('div');
    div.className = 'msg bot';
    div.id = 'typing-indicator';

    const avatar = document.createElement('div');
    avatar.className = 'msg-avatar';
    avatar.textContent = '🩸';

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    bubble.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';

    div.appendChild(avatar);
    div.appendChild(bubble);
    el.appendChild(div);
    el.scrollTop = el.scrollHeight;
}

function removeTyping() {
    const t = document.getElementById('typing-indicator');
    if (t) t.remove();
}

// ── Format bot response (basic markdown) ──────────────────────────────────
function formatResponse(text) {
    return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code style="background:#e0e7ff;padding:1px 5px;border-radius:4px;font-size:12px;">$1</code>')
        .replace(/^- (.+)$/gm, '<li>$1</li>')
        .replace(/((<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>')
        .replace(/\n/g, '<br>');
}

// ── Send message ───────────────────────────────────────────────────────────
async function sendMessage() {
    const input = document.getElementById('chat-input');
    const text  = input.value.trim();
    if (!text || isBotTyping) return;

    input.value  = '';
    input.style.height = '';
    isBotTyping  = true;
    document.getElementById('chat-send').disabled = true;

    appendMessage('user', text);

    // Add to history
    chatHistory.push({ role: 'user', content: text });

    appendTyping();

    try {
        // Build messages with system context prepended to first user message
        const messages = chatHistory.map((m, i) => {
            if (i === 0) {
                return { role: 'user', content: buildStatsContext() + '\n\nUser question: ' + m.content };
            }
            return m;
        });

        const formData = new FormData();
        // We send the full conversation context as a single prompt for simplicity
        // (the endpoint is stateless, so we reconstruct context each time)
        const fullPrompt = buildStatsContext() + '\n\n' +
            chatHistory.slice(0, -1).map(m =>
                (m.role === 'user' ? 'User: ' : 'Assistant: ') + m.content
            ).join('\n') +
            (chatHistory.length > 1 ? '\n' : '') +
            'User: ' + text + '\n\nPlease respond concisely.';

        formData.append('prompt', fullPrompt);

        const res  = await fetch('/dashboard/donations/ai-predict', {
            method: 'POST',
            body: formData,
        });
        const data = await res.json();
        const reply = data.result || data.error || 'Sorry, I could not get a response. Please try again.';

        removeTyping();
        appendMessage('bot', formatResponse(reply), true);
        chatHistory.push({ role: 'assistant', content: reply });

        // Keep history manageable (last 10 turns = 20 messages)
        if (chatHistory.length > 20) chatHistory = chatHistory.slice(-20);

    } catch (err) {
        removeTyping();
        appendMessage('bot', '⚠️ Connection error. Please try again.', false);
    }

    isBotTyping = false;
    document.getElementById('chat-send').disabled = false;
}

// ── Quick-ask shortcut ─────────────────────────────────────────────────────
window.quickAsk = function(q) {
    const input = document.getElementById('chat-input');
    input.value = q;
    sendMessage();
};

// ── Textarea auto-resize ───────────────────────────────────────────────────
window.autoResize = function(el) {
    el.style.height = '';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
};

// ── Enter to send (Shift+Enter = newline) ──────────────────────────────────
window.handleKey = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
};

// ── Open / Close ───────────────────────────────────────────────────────────
window.openChat = function() {
    document.getElementById('modal-chat-ai').classList.add('open');

    // Welcome message on first open
    const el = messagesEl();
    if (el.children.length === 0) {
        appendMessage('bot',
            'Hello! I\'m your BloodLink AI assistant. I have access to your current donation stats and can answer questions about blood type distribution, shortage risks, donor trends, screening rates, and more.<br><br>Ask me anything or tap a quick question above. 👆',
            true
        );
    }

    setTimeout(() => document.getElementById('chat-input').focus(), 150);
};

window.closeChat = function() {
    document.getElementById('modal-chat-ai').classList.remove('open');
};

// ── Expose sendMessage globally ────────────────────────────────────────────
window.sendMessage = sendMessage;

// ── Backdrop click closes ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
    const chatModal = document.getElementById('modal-chat-ai');
    if (chatModal) {
        chatModal.addEventListener('click', function(e) {
            if (e.target === this) closeChat();
        });
    }
});

})();
</script>

<!-- ══ AI CHATBOT MODAL ══ -->
<div id="modal-chat-ai">
    <div id="chat-window">

        <!-- Header -->
        <div id="chat-header">
            <div class="chat-avatar">🩸</div>
            <div class="chat-header-info">
                <h4>BloodLink AI Assistant</h4>
                <p>Ask anything about donations &amp; data</p>
            </div>
            <button class="chat-close" onclick="closeChat()" type="button">✕</button>
        </div>

        <!-- Quick question chips -->
        <div id="chat-quick">
            <button class="quick-btn" type="button" onclick="quickAsk('What blood types do we have the most of?')">🩸 Blood type breakdown</button>
            <button class="quick-btn" type="button" onclick="quickAsk('Which blood type is most at risk of shortage?')">⚠️ Shortage risk</button>
            <button class="quick-btn" type="button" onclick="quickAsk('How many donations were completed vs cancelled?')">📊 Completion rate</button>
            <button class="quick-btn" type="button" onclick="quickAsk('When is the best month to run a blood drive?')">📅 Best event timing</button>
            <button class="quick-btn" type="button" onclick="quickAsk('What percentage of donors passed screening?')">🔬 Screening rate</button>
            <button class="quick-btn" type="button" onclick="toggleChatCharts()" style="background:#dcfce7;color:#166534;border-color:#bbf7d0;">📊 View Charts</button>
        </div>

        <!-- Charts area (hidden by default) -->
        <div id="chat-charts" style="display:none; padding:16px; background:#f8fafc; border-bottom:1px solid #f1f5f9; max-height:260px; overflow-y:auto; flex-shrink:0;">
            <p style="font-size:12px;color:var(--subtle);margin:0 0 10px;">📊 Monthly donations &amp; blood type distribution</p>
            <canvas id="donations-chart" height="130"></canvas>
            <hr style="margin:14px 0;border:none;border-top:1px solid var(--line)">
            <canvas id="bloodtype-chart" height="130"></canvas>
        </div>

        <!-- Messages area -->
        <div id="chat-messages">
            <!-- Welcome message injected by JS -->
        </div>

        <!-- Input bar -->
        <div id="chat-input-bar">
            <textarea id="chat-input"
                placeholder="Ask about donations, blood types, stats…"
                rows="1"
                onkeydown="handleKey(event)"
                oninput="autoResize(this)"></textarea>
            <button id="chat-send" type="button" onclick="sendMessage()">➤</button>
        </div>
        <div class="chat-disclaimer">AI may make mistakes · Always verify critical medical decisions</div>
    </div>
</div>

{% endblock %}