{% set page_title = 'Donations' %}
{% set page_description = 'Manage and track blood donations across the network.' %}
{% extends 'dashboard/layouts/back_office.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<style>
    :root {
        --brand: #8f1d1f; --brand-2: #b3272a;
        --ok: #16a34a; --warn: #f59e0b; --danger: #dc2626;
        --line: #e2e8f0; --subtle: #64748b; --ink: #0f172a;
    }

    .flash { border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: 13px; }
    .flash.success { background: #edf9f0; border: 1px solid #b6e2c1; color: #1b6a34; }
    .flash.error   { background: #fff1f2; border: 1px solid #fecdd3; color: #9f1239; }

    /* Expired banner */
    .expired-banner { background: #fff1f2; border: 1px solid #fecdd3; border-left: 4px solid var(--danger); border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; }
    .expired-banner-title { font-size: 14px; font-weight: 700; color: #991b1b; margin-bottom: 6px; }
    .expired-banner-item { font-size: 12px; color: #9f1239; margin: 2px 0; }

    .add-btn { border: 0; border-radius: 10px; background: linear-gradient(135deg,var(--brand),var(--brand-2)); color: #fff; font-weight: 700; padding: 10px 18px; cursor: pointer; font-family: inherit; font-size: 14px; }
    .chart-btn { border: 1px solid #d6deea; border-radius: 10px; background: #fff; color: var(--ink); font-weight: 700; padding: 10px 18px; cursor: pointer; font-family: inherit; font-size: 14px; margin-left: 8px; }
    .chart-btn:hover { background: #f1f5f9; }

    /* Stats */
    .stats { display: grid; grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); gap: 12px; margin-bottom: 20px; }
    .stat { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 14px; }
    .stat-label { font-size: 11px; font-weight: 700; color: var(--subtle); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
    .stat-value { font-size: 26px; font-weight: 800; color: var(--ink); }

    /* Filters */
    .filters { display: grid; grid-template-columns: 1fr 140px 200px 90px; gap: 10px; margin-bottom: 20px; align-items: end; }
    .filters input, .filters select { height: 38px; border: 1px solid #d6deea; border-radius: 8px; padding: 0 10px; background: #fff; font-size: 13px; font-family: inherit; }
    .filters button { height: 38px; background: var(--brand); color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-family: inherit; }

    /* Cards */
    .list { display: grid; gap: 14px; }
    .card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px; transition: box-shadow .2s; }
    .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
    .card.expired { border-color: #fca5a5; background: #fff5f5; }
    .expired-card-banner { background: #fee2e2; border-radius: 8px; padding: 8px 12px; margin-bottom: 12px; font-size: 12px; font-weight: 700; color: #991b1b; }
    .card-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; gap: 12px; flex-wrap: wrap; }
    .donor-info { display: flex; align-items: center; gap: 10px; }
    .donor-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,var(--brand),var(--brand-2)); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 15px; flex-shrink: 0; }
    .donor-name { margin: 0; font-size: 16px; font-weight: 700; color: var(--ink); cursor: pointer; text-decoration: underline dotted; }
    .donor-name:hover { color: var(--brand); }
    .donor-sub { margin: 3px 0 0; font-size: 12px; color: var(--subtle); }
    .badges-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .badge-completed { background: #dcfce7; color: #166534; }
    .badge-cancelled { background: #fee2e2; color: #991b1b; }
    .badge-failed    { background: #fee2e2; color: #991b1b; }
    .badge-deferred  { background: #fef3c7; color: #92400e; }
    .badge-scheduled { background: #dbeafe; color: #1e40af; }
    .badge-first     { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .badge-returning { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .badge-expired   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    .meta { display: grid; grid-template-columns: repeat(auto-fit,minmax(130px,1fr)); gap: 10px; font-size: 13px; }
    .meta-item { display: flex; flex-direction: column; gap: 2px; }
    .meta-label { font-size: 10px; font-weight: 700; color: var(--subtle); text-transform: uppercase; letter-spacing: .05em; }
    .meta-value { font-size: 14px; font-weight: 600; color: var(--ink); }

    .crud-bar { display: flex; gap: 6px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #f1f5f9; flex-wrap: wrap; }
    .btn-crud { flex: 1; min-width: 80px; padding: 8px; border: none; border-radius: 7px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 4px; }
    .btn-edit-c   { background: #e0e7ff; color: #3730a3; }
    .btn-edit-c:hover { background: #c7d2fe; }
    .btn-qr   { background: #e0f2fe; color: #0369a1; }
    .btn-qr:hover { background: #bae6fd; }
    .btn-pdf  { background: #dcfce7; color: #166534; }
    .btn-pdf:hover { background: #bbf7d0; }
    .btn-del  { background: #fee2e2; color: #991b1b; }
    .btn-del:hover { background: #fecaca; }

    .empty { text-align: center; padding: 48px; background: #f8fafc; border-radius: 12px; color: var(--subtle); border: 2px dashed #cbd5e1; }

    /* Modals */
    .modal-bg { position: fixed; inset: 0; background: rgba(15,23,42,.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
    .modal-bg.open { display: flex; }
    .modal { width: min(800px,96vw); max-height: 95vh; overflow-y: auto; background: #fff; border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,.2); }
    .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--line); }
    .modal-head h3 { margin: 0; font-size: 20px; font-weight: 800; }
    .modal-close { border: 1px solid #cbd5e1; background: #fff; border-radius: 8px; width: 34px; height: 34px; font-size: 18px; cursor: pointer; display: grid; place-items: center; }
    .modal-body { padding: 20px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .modal-body .full { grid-column: 1 / -1; }
    .modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px; border-top: 1px solid var(--line); background: #f8fafc; border-radius: 0 0 16px 16px; }
    .field { display: grid; gap: 5px; }
    .field label { font-size: 11px; font-weight: 700; color: var(--subtle); text-transform: uppercase; letter-spacing: .06em; }
    .field input, .field select, .field textarea { height: 40px; border: 1px solid #d6deea; border-radius: 9px; padding: 0 12px; background: #fbfdff; font-family: inherit; font-size: 14px; }
    .field textarea { height: auto; min-height: 80px; padding: 10px 12px; resize: vertical; }
    .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(143,29,31,.07); }
    .checkbox-field { display: flex; align-items: center; gap: 8px; }
    .checkbox-field input { width: 18px; height: 18px; }
    .btn { padding: 9px 18px; border: none; border-radius: 9px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .btn-ghost { background: #f1f5f9; color: #0b1736; }
    .btn-ghost:hover { background: #e2e8f0; }
    .btn-brand { background: var(--brand); color: #fff; }
    .btn-brand:hover { background: #7a1818; }
    .btn-blue { background: #0369a1; color: #fff; }
    .btn-blue:hover { background: #0284c7; }
    .form-hint { font-size: 11px; color: var(--subtle); }

    /* QR Modal */
    .qr-container { text-align: center; padding: 20px; }
    .qr-info { background: #f8fafc; border-radius: 10px; padding: 14px; margin-top: 16px; text-align: left; font-size: 13px; }
    .qr-info div { margin-bottom: 6px; }
    .qr-info strong { color: var(--subtle); font-size: 11px; text-transform: uppercase; display: block; }

    /* Chart */
    .chart-wrap { padding: 20px 24px; }

    /* History modal */
    .history-list { display: grid; gap: 10px; max-height: 380px; overflow-y: auto; padding-right: 4px; }
    .history-card { background: #f8fafc; border: 1px solid var(--line); border-radius: 10px; padding: 14px; }
    .history-card.h-expired { border-color: #fca5a5; background: #fff5f5; }
    .history-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .donor-profile { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; background: #f0fdf4; border-radius: 10px; padding: 14px; margin-bottom: 16px; }
    .profile-item { display: flex; flex-direction: column; gap: 2px; }
    .profile-label { font-size: 10px; font-weight: 700; color: var(--subtle); text-transform: uppercase; }
    .profile-value { font-size: 14px; font-weight: 700; color: var(--ink); }

    @media (max-width: 900px) {
        .filters { grid-template-columns: 1fr 1fr; }
        .modal-body { grid-template-columns: 1fr; }
    }
    /* ── Chat modal ─────────────────────────────────────────────────────────── */
    #modal-chat-ai {
     position: fixed;
     inset: 0;
     background: rgba(15,23,42,.55);
     display: none;
     align-items: flex-end;
     justify-content: flex-end;
     z-index: 1100;
     padding: 24px;
    }
   #modal-chat-ai.open { display: flex; }

    #chat-window {
     width: min(460px, 96vw);
     height: min(640px, 90vh);
     background: #fff;
     border-radius: 18px;
     box-shadow: 0 32px 80px rgba(0,0,0,.22);
     display: flex;
     flex-direction: column;
     overflow: hidden;
     animation: slideUp .22s ease;
    }
 @keyframes slideUp {
    from { transform: translateY(24px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
 }

 /* Header */
 #chat-header {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
 }
 .chat-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,.2);
    display: grid; place-items: center;
    font-size: 18px;
    flex-shrink: 0;
 }
 .chat-header-info h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
 }
 .chat-header-info p {
    margin: 2px 0 0;
    font-size: 11px;
    color: rgba(255,255,255,.75);
 }
 .chat-close {
    margin-left: auto;
    background: rgba(255,255,255,.15);
    border: none;
    border-radius: 8px;
    color: #fff;
    width: 32px; height: 32px;
    font-size: 16px;
    cursor: pointer;
    display: grid; place-items: center;
 }
 .chat-close:hover { background: rgba(255,255,255,.25); }

 /* Quick questions */
 #chat-quick {
    padding: 12px 16px 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex-shrink: 0;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 10px;
 }
 .quick-btn {
    font-size: 11px;
    font-weight: 600;
    background: #f0f4ff;
    color: #4338ca;
    border: 1px solid #c7d2fe;
    border-radius: 20px;
    padding: 4px 10px;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s;
    white-space: nowrap;
 }
 .quick-btn:hover { background: #e0e7ff; }

 /* Messages */
 #chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
 }
 #chat-messages::-webkit-scrollbar { width: 4px; }
 #chat-messages::-webkit-scrollbar-track { background: transparent; }
 #chat-messages::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

 .msg { display: flex; gap: 8px; align-items: flex-end; max-width: 92%; }
 .msg.user { flex-direction: row-reverse; align-self: flex-end; }
 .msg.bot  { align-self: flex-start; }

 .msg-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
    display: grid; place-items: center;
    font-size: 12px;
    font-weight: 700;
 }
 .msg.bot  .msg-avatar { background: linear-gradient(135deg,#4f46e5,#7c3aed); color: #fff; }
 .msg.user .msg-avatar { background: linear-gradient(135deg,#8f1d1f,#b3272a); color: #fff; }

 .msg-bubble {
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 100%;
    word-break: break-word;
 }
 .msg.bot  .msg-bubble { background: #f1f5f9; color: #0f172a; border-bottom-left-radius: 4px; }
 .msg.user .msg-bubble { background: linear-gradient(135deg,#4f46e5,#7c3aed); color: #fff; border-bottom-right-radius: 4px; }

 /* Typing indicator */
 .typing-dots { display: flex; gap: 4px; align-items: center; padding: 4px 0; }
 .typing-dots span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #94a3b8;
    animation: bounce 1.2s infinite;
 }
 .typing-dots span:nth-child(2) { animation-delay: .2s; }
 .typing-dots span:nth-child(3) { animation-delay: .4s; }
 @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30%            { transform: translateY(-6px); }
 }

 /* Input bar */
 #chat-input-bar {
    padding: 12px 14px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    gap: 8px;
    align-items: flex-end;
    flex-shrink: 0;
    background: #fff;
 }
 #chat-input {
    flex: 1;
    border: 1px solid #d6deea;
    border-radius: 12px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 13px;
    resize: none;
    min-height: 40px;
    max-height: 100px;
    overflow-y: auto;
    outline: none;
    line-height: 1.5;
    background: #f8fafc;
 }
 #chat-input:focus { border-color: #6366f1; background: #fff; }
 #chat-send {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg,#4f46e5,#7c3aed);
    border: none;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    display: grid; place-items: center;
    flex-shrink: 0;
    transition: opacity .15s;
 }
 #chat-send:disabled { opacity: .4; cursor: default; }
 #chat-send:hover:not(:disabled) { opacity: .9; }

 /* Disclaimer */
 .chat-disclaimer {
    text-align: center;
    font-size: 10px;
    color: #94a3b8;
    padding: 4px 16px 10px;
    flex-shrink: 0;
 }

 /* Formatted response content */
 .msg-bubble strong { font-weight: 700; }
 .msg-bubble ul { margin: 6px 0; padding-left: 16px; }
 .msg-bubble li { margin: 2px 0; }
 .msg-bubble .highlight { background: rgba(99,102,241,.12); border-radius: 4px; padding: 1px 5px; font-weight: 600; color: #4338ca; }
 </style>

 {% endblock %}

 {% block page_actions %}
    {% if user_type != 'DONOR' %}
        <button type="button" class="add-btn" onclick="openCreate()">+ Add Donation</button>
        <button type="button" class="chart-btn" onclick="openChat()" style="background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff;border:none;">💬 AI Assistant</button>
    {% endif %}
 {% endblock %}

 {% block module_content %}

 {% for msg in app.flashes('success') %}<div class="flash success">✓ {{ msg }}</div>{% endfor %}
 {% for msg in app.flashes('error') %}<div class="flash error">✕ {{ msg }}</div>{% endfor %}

 {# Expired banner #}
 {% set expiredDonations = [] %}
 {% for donation in donations %}
    {% set daysSince = ('now'|date('U') - donation.donation_date|date('U')) / 86400 %}
    {% if daysSince > 42 %}
        {% set expiredDonations = expiredDonations|merge([donation]) %}
    {% endif %}
 {% endfor %}
 {% if expiredDonations|length > 0 %}
 <div class="expired-banner">
    <div class="expired-banner-title">⚠ Expired Donations — {{ expiredDonations|length }} donation(s) older than 42 days!</div>
    {% for d in expiredDonations %}
    <div class="expired-banner-item">• Donation ID: {{ d.donation_id }} — {{ d.donor_first_name }} {{ d.donor_last_name }} — donated on {{ d.donation_date|date('Y-m-d H:i') }}</div>
    {% endfor %}
 </div>
 {% endif %}

 <!-- Stats -->
 <div class="stats">
    <div class="stat"><div class="stat-label">Total</div><div class="stat-value">{{ stats.total }}</div></div>
    <div class="stat"><div class="stat-label">Completed</div><div class="stat-value" style="color:var(--ok)">{{ stats.completed }}</div></div>
    <div class="stat"><div class="stat-label">Cancelled</div><div class="stat-value" style="color:var(--danger)">{{ stats.cancelled }}</div></div>
    <div class="stat"><div class="stat-label">Screening OK</div><div class="stat-value" style="color:var(--ok)">{{ stats.screening_passed }}</div></div>
    <div class="stat"><div class="stat-label">Total Volume (mL)</div><div class="stat-value" style="color:var(--brand)">{{ stats.total_litres|number_format(0) }}</div></div>
 </div>

 <!-- Filters -->
 <form class="filters" method="GET" action="{{ path('donations_index') }}">
    <input type="text" name="q" value="{{ search }}" placeholder="Search donor, hospital...">
    <select name="blood_type">
        <option value="">All Blood Types</option>
        {% for bt in blood_types %}
        <option value="{{ bt.blood_type_id }}" {% if blood_filter == bt.blood_type_id %}selected{% endif %}>{{ bt.blood_type_id }}</option>
        {% endfor %}
    </select>
    <select name="event_id">
        <option value="">All Events</option>
        {% for ev in events %}
        <option value="{{ ev.event_id }}" {% if event_filter == ev.event_id %}selected{% endif %}>{{ ev.name }}</option>
        {% endfor %}
    </select>
    <button type="submit">Search</button>
 </form>

 <!-- Donations List -->
 {% if donations %}
 <div class="list">
    {% for donation in donations %}
    {% set isFirstTime = donation.prior_donations == 0 %}
    {% set daysSince = ('now'|date('U') - donation.donation_date|date('U')) / 86400 %}
    {% set isExpired = daysSince > 42 %}
    <div class="card {% if isExpired %}expired{% endif %}">
        {% if isExpired %}
        <div class="expired-card-banner">⚠ This donation has expired — collected more than 42 days ago!</div>
        {% endif %}
        <div class="card-head">
            <div class="donor-info">
                <div class="donor-avatar">{{ donation.donor_first_name|first|upper }}{{ donation.donor_last_name|first|upper }}</div>
                <div>
                    <p class="donor-name" onclick="loadHistory('{{ donation.user_id }}', '{{ donation.donor_first_name }} {{ donation.donor_last_name }}')">
                        {{ donation.donor_first_name }} {{ donation.donor_last_name }}
                    </p>
                    <p class="donor-sub">📍 {{ donation.hospital_name ?? 'N/A' }}{% if donation.event_name %} · 📅 {{ donation.event_name }}{% endif %}</p>
                </div>
            </div>
            <div class="badges-row">
                {% if isFirstTime %}
                    <span class="badge badge-first">⭐ First Time</span>
                {% else %}
                    <span class="badge badge-returning">🔄 Returning</span>
                {% endif %}
                {% if isExpired %}<span class="badge badge-expired">⚠ Expired</span>{% endif %}
                <span class="badge badge-{{ donation.status|lower }}">{{ donation.status }}</span>
            </div>
        </div>
        <div class="meta">
            <div class="meta-item">
                <span class="meta-label">Blood Type</span>
                <span class="meta-value">{{ donation.blood_code|default('—') }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Date</span>
                <span class="meta-value">{{ donation.donation_date|date('M d, Y') }}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Volume</span>
                <span class="meta-value">{{ donation.volume_collected|default('—') }} mL</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Screening</span>
                <span class="meta-value">{% if donation.screening_passed %}✓ Passed{% else %}✗ Failed{% endif %}</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Total Donations</span>
                <span class="meta-value">{{ donation.donor_total_donations|default('—') }}</span>
            </div>
            {% if donation.medical_notes %}
            <div class="meta-item" style="grid-column:1/-1">
                <span class="meta-label">📋 Notes</span>
                <span class="meta-value" style="font-weight:400;font-size:13px;">{{ donation.medical_notes }}</span>
            </div>
            {% endif %}
        </div>
        {% if user_type != 'DONOR' %}
        <div class="crud-bar">
            <button class="btn-crud btn-edit-c" type="button" onclick="window.bl_openEdit({{ donation|json_encode }})">Edit</button>
            <button class="btn-crud btn-history" type="button" onclick="window.bl_loadHistory('{{ donation.user_id }}', '{{ donation.donor_first_name }} {{ donation.donor_last_name }}')">History</button>
            <button class="btn-crud btn-qr" type="button" onclick="window.bl_openQr({{ donation|json_encode }})">QR Code</button>
            <a href="{{ path('donations_pdf', {id: donation.donation_id}) }}" class="btn-crud btn-pdf">PDF</a>
            <form method="POST" action="{{ path('donations_delete', {id: donation.donation_id}) }}" onsubmit="return confirm('Delete this donation?');" style="flex:1;display:flex;">
                <button class="btn-crud btn-del" style="flex:1;" type="submit">Delete</button>
            </form>
        </div>
        {% endif %}
    </div>
    {% endfor %}
 </div>
 {% else %}
