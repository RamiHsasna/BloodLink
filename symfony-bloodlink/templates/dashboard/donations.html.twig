{% extends 'base.html.twig' %}

{% block title %}Donations{% endblock %}

{% block body %}
<style>
    :root {
        --bg: #f1f3f7;
        --panel: #ffffff;
        --ink: #0f172a;
        --subtle: #64748b;
        --line: #e2e8f0;
        --nav: #0b1736;
        --nav-2: #121f45;
        --brand: #8f1d1f;
        --brand-2: #b3272a;
        --ok: #16a34a;
        --warn: #f59e0b;
        --danger: #dc2626;
    }
    body { margin: 0; font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: var(--ink); }
    .shell { min-height: 100vh; display: grid; grid-template-columns: 260px 1fr; }

    .sidebar {
        background: linear-gradient(180deg, var(--nav), #09122d 65%);
        color: #e2e8f0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #19254c;
    }
    .brand { padding: 24px 20px; border-bottom: 1px solid #22315f; }
    .brand h2 { margin: 0; font-size: 29px; font-family: Georgia, "Times New Roman", serif; color: #fff; }
    .brand p { margin: 4px 0 0; color: #8fa0ce; font-size: 13px; }
    .menu { padding: 16px 12px; display: grid; gap: 8px; }
    .menu a { text-decoration: none; color: #c8d3f3; padding: 11px 12px; border-radius: 10px; font-weight: 600; }
    .menu a.active { background: #1d2c56; color: #fff; border-left: 3px solid #ef4444; padding-left: 9px; }
    .menu a:hover { background: #16254d; }
    .profile { margin-top: auto; padding: 16px; border-top: 1px solid #22315f; }
    .profile .name { margin: 0; font-size: 14px; color: #fff; }
    .profile .role { margin: 4px 0 10px; color: #8fa0ce; font-size: 12px; }
    .logout-btn { width: 100%; height: 36px; border: 1px solid #2d3e6f; background: #101d42; color: #dbe5ff; border-radius: 8px; font-weight: 600; }

    .main { padding: 24px; }
    .head { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 14px; }
    .head h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 40px; }
    .head p { margin: 6px 0 0; color: var(--subtle); }

    .flash { border-radius: 10px; padding: 10px 12px; margin-bottom: 12px; font-size: 13px; }
    .flash.success { background: #edf9f0; border: 1px solid #b6e2c1; color: #1b6a34; }
    .flash.error { background: #fff1f2; border: 1px solid #fecdd3; color: #9f1239; }

    .add-btn { border: 0; border-radius: 10px; background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; font-weight: 700; padding: 10px 16px; }

    .filters { display: grid; grid-template-columns: 1fr 180px 120px; gap: 12px; margin-bottom: 14px; }
    .filters input, .filters select { width: 100%; height: 42px; border: 1px solid #d6deea; border-radius: 10px; padding: 0 12px; background: #fff; }
    .filters button { border: 0; border-radius: 10px; background: #0f172a; color: #fff; font-weight: 700; }

    .stats { display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .stat { background: #fff; border: 1px solid var(--line); border-radius: 11px; padding: 10px 12px; font-size: 14px; }
    .dot { font-size: 20px; vertical-align: middle; margin-right: 6px; }
    .dot.green { color: var(--ok); }
    .dot.orange { color: var(--warn); }

    .list { display: grid; gap: 12px; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 14px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05); }
    .card-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
    .user-name { margin: 0; font-size: 18px; font-weight: 700; }
    .email { margin: 2px 0 0; color: var(--subtle); font-size: 13px; }
    .badge { border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 700; }
    .badge-donor { background: #dcfce7; color: #166534; }
    .badge-staff { background: #fff7ed; color: #9a3412; }
    .badge-scheduled { background: #dbeafe; color: #1e40af; }
    .badge-completed { background: #dcfce7; color: #166534; }
    .badge-cancelled { background: #fee2e2; color: #991b1b; }
    .meta { margin-top: 10px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; color: #475569; font-size: 13px; }

    .crud-bar { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
    .btn-edit { border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; border-radius: 9px; padding: 8px 12px; font-weight: 700; }
    .btn-delete { border: 1px solid #fecaca; background: #fff1f2; color: #b91c1c; border-radius: 9px; padding: 8px 12px; font-weight: 700; }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }
    .modal-bg {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }
    .modal-overlay.open, .modal-bg.open { display: flex; }
    .modal {
        width: min(760px, 96vw);
        max-height: 92vh;
        overflow: auto;
        background: #fff;
        border-radius: 14px;
        border: 1px solid var(--line);
        box-shadow: 0 20px 40px rgba(2, 6, 23, 0.25);
        padding: 16px;
    }
    .modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    .modal-head h3 { margin: 0; font-size: 21px; }
    .modal-close {
        border: 1px solid #cbd5e1;
        background: #fff;
        border-radius: 8px;
        width: 34px;
        height: 34px;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }
    .modal-body {
        margin: 16px 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    .modal-body .full { grid-column: 1 / -1; }
    .modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }
    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-ghost {
        background: #f1f5f9;
        color: #0b1736;
    }
    .btn-ghost:hover { background: #e2e8f0; }
    .btn-brand {
        background: var(--brand);
        color: #fff;
    }
    .btn-brand:hover { background: #7a1818; }
    .modal-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }
    .modal-grid .full { grid-column: 1 / -1; }
    .field {
        display: grid;
        gap: 4px;
    }
    .field label { margin: 0; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--subtle); font-weight: 700; }
    .field input, .field select, .field textarea {
        height: 40px;
        border: 1px solid #d6deea;
        border-radius: 9px;
        padding: 0 10px;
        background: #fbfdff;
    }
    .field textarea {
        height: auto;
        min-height: 80px;
        padding: 8px 10px;
        resize: vertical;
    }
    .field-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    .checkbox-field {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .checkbox-field input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }
    .checkbox-field label {
        text-transform: none;
        cursor: pointer;
    }
    .subsection {
        margin-top: 4px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px;
        display: none;
    }
    .subsection.open { display: block; }
    .subsection h4 { margin: 0 0 8px; font-size: 14px; color: #334155; }
    .sub-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }
    .modal-actions {
        margin-top: 12px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }
    .btn-secondary { border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 9px; padding: 8px 12px; }
    .btn-primary { border: 0; border-radius: 9px; background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; font-weight: 700; padding: 8px 12px; }

    .empty { border: 1px dashed #cbd5e1; border-radius: 12px; padding: 28px; text-align: center; color: var(--subtle); background: #fff; }

    @media (max-width: 1100px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { min-height: auto; }
        .modal-grid, .sub-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 900px) {
        .filters { grid-template-columns: 1fr; }
        .meta { grid-template-columns: 1fr; }
    }

    /* New Layout Styles */
    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }
    .stat {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .stat strong { font-size: 18px; color: #0b1736; }
    .dot { font-size: 20px; }
    .dot.green { color: #16a34a; }
    .dot.orange { color: #f97316; }

    .filters {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 10px;
        margin-bottom: 20px;
        align-items: end;
    }
    .filters input, .filters select {
        height: 38px;
        border: 1px solid #d6deea;
        border-radius: 8px;
        padding: 0 10px;
        background: #fbfdff;
        font-size: 14px;
    }
    .filters button {
        height: 38px;
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
    }

    .list {
        display: grid;
        gap: 12px;
        margin-bottom: 20px;
    }
    .card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
    }
    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }
    .user-name {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: #0b1736;
    }
    .card-head .email {
        margin: 4px 0 0;
        font-size: 12px;
        color: #64748b;
    }
    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .badge-scheduled { background: #fef3c7; color: #92400e; }
    .badge-completed { background: #dcfce7; color: #166534; }
    .badge-cancelled { background: #fee2e2; color: #991b1b; }

    .meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 10px;
        font-size: 13px;
        color: #475569;
    }
    .meta div { display: flex; flex-direction: column; }
    .meta strong { color: #0b1736; font-size: 14px; }

    .crud-bar {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #f1f5f9;
    }
    .btn-edit, .btn-delete {
        flex: 1;
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-edit {
        background: #e0e7ff;
        color: #3730a3;
    }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete {
        background: #fee2e2;
        color: #991b1b;
    }
    .btn-delete:hover { background: #fecaca; }

    .empty {
        text-align: center;
        padding: 40px 20px;
        background: #f8fafc;
        border-radius: 10px;
        color: #64748b;
        font-size: 14px;
    }

    @media (max-width: 768px) {
        .filters { grid-template-columns: 1fr; }
        .meta { grid-template-columns: repeat(2, 1fr); }
    }

</style>

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <h2>BloodLink</h2>
            <p>Dashboard</p>
        </div>
        <nav class="menu">
            <a href="{{ path('dashboard_users') }}">Users</a>
            <a href="{{ path('donations_index') }}" class="active">Donations</a>
            <a href="{{ path('donation_events_index') }}">Donation Events</a>
            <a href="{{ path('dashboard_donor_eligibility') }}">Donor Eligibility</a>
        </nav>
        <div class="profile">
            <p class="name">{{ session_user.first_name|default('User') }} {{ session_user.last_name|default('') }}</p>
            <p class="role">{{ session_user.user_type|default('N/A') }}</p>
            <form method="post" action="{{ path('auth_logout') }}">
                <button class="logout-btn" type="submit">Logout</button>
            </form>
        </div>
    </aside>

    <main class="main">
        <div class="head">
            <div>
                <h1>Donations</h1>
                <p>Manage and track blood donations across the network.</p>
            </div>
            {% if user_type != 'DONOR' %}<button type="button" class="add-btn" id="addDonationBtn" onclick="openCreate()">+ Add Donation</button>{% endif %}
        </div>

        {% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}
        {% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}

        <!-- Stats -->
        <div class="stats">
            <div class="stat"><span class="dot green">●</span> Total: <strong>{{ stats.total }}</strong></div>
            <div class="stat"><span class="dot">●</span> Scheduled: <strong>{{ stats.scheduled }}</strong></div>
            <div class="stat"><span class="dot green">●</span> Completed: <strong>{{ stats.completed }}</strong></div>
            <div class="stat"><span class="dot green">●</span> Screening: <strong>{{ stats.screening_passed }}</strong></div>
            <div class="stat"><span class="dot orange">●</span> Units: <strong>{{ stats.total_units_collected }}</strong></div>
        </div>

        <!-- Filters -->
        {% if user_type != 'DONOR' %}
        <form class="filters" method="GET" action="{{ path('donations_index') }}">
            <input type="text" name="q" value="{{ search }}" placeholder="Search by donor name, event, or hospital…">
            <select name="status">
                <option value="">All Statuses</option>
                <option value="COMPLETED" {% if status_filter == 'COMPLETED' %}selected{% endif %}>Completed</option>
                <option value="CANCELLED" {% if status_filter == 'CANCELLED' %}selected{% endif %}>Cancelled</option>
                <option value="FAILED" {% if status_filter == 'FAILED' %}selected{% endif %}>Failed</option>
                <option value="DEFERRED" {% if status_filter == 'DEFERRED' %}selected{% endif %}>Deferred</option>
            </select>
            <button type="submit">Search</button>
        </form>
        {% endif %}

        <!-- Donations List -->
        {% if donations %}
        <div class="list">
            {% for donation in donations %}
            <div class="card">
                <div class="card-head">
                    <div>
                        <p class="user-name">{{ donation.donor_first_name }} {{ donation.donor_last_name }}</p>
                        <p class="email">📍 {{ donation.hospital_name ?? 'N/A' }}</p>
                    </div>
                    <span class="badge badge-{{ donation.status|lower }}">{{ donation.status|upper }}</span>
                </div>
                <div class="meta">
                    <div><strong>Blood:</strong> {{ donation.blood_type_id }}</div>
                    <div><strong>Date:</strong> {{ donation.donation_date|date('M d, Y') }}</div>
                    <div><strong>Event:</strong> {{ donation.donation_event_name ?? '—' }}</div>
                    <div><strong>Units:</strong> {{ donation.units_collected ?? 0 }}</div>
                    <div><strong>Screening:</strong> 
                        {% if donation.screening_passed == 1 %}✓ Passed
                        {% elseif donation.screening_passed == 0 %}✗ Failed
                        {% else %}Pending{% endif %}
                    </div>
                    <div><strong>Volume:</strong> {{ donation.volume_collected ?? '—' }} mL</div>
                </div>
                {% if user_type != 'DONOR' %}
                <div class="crud-bar">
                    <button class="btn-edit" onclick="openEdit({{ donation|json_encode }})">✎ Edit</button>
                    <form method="POST" action="{{ path('donations_delete', {id: donation.donation_id}) }}" onsubmit="return confirm('Delete this donation?');" style="display:inline;">
                        <button class="btn-delete">🗑 Delete</button>
                    </form>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty">
            {% if user_type == 'DONOR' %}
                No donations recorded yet. Visit an event to make your first donation!
            {% else %}
                No donations found in the system.
            {% endif %}
        </div>
        {% endif %}
    </main>
</div>

<!-- Create Modal (Admin Only) -->
{% if user_type != 'DONOR' %}
<div class="modal-bg" id="modal-create">
    <div class="modal">
        <div class="modal-head">
            <h3>➕ New Donation Record</h3>
            <button class="modal-close" onclick="closeCreate()">✕</button>
        </div>
        <form method="POST" action="{{ path('donations_create') }}">
            <div class="modal-body">
                <div class="field full">
                    <label>Donor Name *</label>
                    <input type="text" name="donor_name" required placeholder="e.g. John Doe">
                    <small style="margin-top: 2px; font-size: 11px; color: var(--subtle);">Enter donor name or UUID. New donors will be created automatically.</small>
                </div>
                <div class="field">
                    <label>Blood Type</label>
                    <input type="text" name="blood_type_id" placeholder="e.g. O+, A-, B+">  
                </div>
                <div class="field">
                    <label>Donor Phone (for new donor)</label>
                    <input type="tel" name="donor_phone" placeholder="(optional)">
                </div>
                <div class="field">
                    <label>Donor City (for new donor)</label>
                    <input type="text" name="donor_city" placeholder="(optional)">
                </div>
                <div class="field">
                    <label>Donation Event</label>
                    <select name="donation_event_id">
                        <option value="">— Select Event —</option>
                        {% for ev in donation_events %}
                        <option value="{{ ev.event_id }}">{{ ev.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label>Hospital</label>
                    <select name="hospital_id">
                        <option value="">— Select Hospital —</option>
                        {% for h in hospitals %}
                        <option value="{{ h.hospital_id }}">{{ h.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label>Donation Date *</label>
                    <input type="datetime-local" name="donation_date" required>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label>Units Collected</label>
                        <input type="number" name="units_collected" min="0" placeholder="1">
                    </div>
                    <div class="field">
                        <label>Volume (mL)</label>
                        <input type="number" step="0.01" min="0" max="999.99" name="volume_collected" placeholder="450">
                    </div>
                </div>
                <div class="field">
                    <label>Status</label>
                    <select name="status">
                        <option value="COMPLETED" selected>Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                        <option value="FAILED">Failed</option>
                        <option value="DEFERRED">Deferred</option>
                    </select>
                </div>
                <div class="field">
                    <label>Medical Notes</label>
                    <textarea name="medical_notes" placeholder="Optional medical notes…"></textarea>
                </div>
                <div class="checkbox-field">
                    <input type="checkbox" id="screening-create" name="screening_passed">
                    <label for="screening-create" style="margin: 0; text-transform: none;">Screening Passed</label>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn btn-ghost" onclick="closeCreate()">Cancel</button>
                <button type="submit" class="btn btn-brand">Create Donation</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal-bg" id="modal-edit">
    <div class="modal">
        <div class="modal-head">
            <h3>✏️ Edit Donation Record</h3>
            <button class="modal-close" onclick="closeEdit()">✕</button>
        </div>
        <form method="POST" id="edit-form" action="">
            <div class="modal-body">
                <div class="field full">
                    <label>Donor Name *</label>
                    <input type="text" id="edit-donor" name="donor_name" required placeholder="e.g. John Doe">
                    <small style="margin-top: 2px; font-size: 11px; color: var(--subtle);">Enter donor name or UUID.</small>
                </div>
                <div class="field">
                    <label>Blood Type</label>
                    <input type="text" id="edit-blood-type" name="blood_type_id" placeholder="e.g. O+, A-, B+">
                </div>
                <div class="field">
                    <label>Donation Event</label>
                    <select name="donation_event_id" id="edit-event">
                        <option value="">— Select Event —</option>
                        {% for ev in donation_events %}
                        <option value="{{ ev.event_id }}">{{ ev.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label>Hospital</label>
                    <select name="hospital_id" id="edit-hospital">
                        <option value="">— Select Hospital —</option>
                        {% for h in hospitals %}
                        <option value="{{ h.hospital_id }}">{{ h.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label>Donation Date *</label>
                    <input type="datetime-local" name="donation_date" id="edit-date" required>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label>Units Collected</label>
                        <input type="number" id="edit-units" name="units_collected" min="0">
                    </div>
                    <div class="field">
                        <label>Volume (mL)</label>
                        <input type="number" step="0.01" min="0" max="999.99" id="edit-volume" name="volume_collected">
                    </div>
                </div>
                <div class="field">
                    <label>Status</label>
                    <select name="status" id="edit-status">
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                        <option value="FAILED">Failed</option>
                        <option value="DEFERRED">Deferred</option>
                    </select>
                </div>
                <div class="field">
                    <label>Medical Notes</label>
                    <textarea id="edit-notes" name="medical_notes"></textarea>
                </div>
                <div class="checkbox-field">
                    <input type="checkbox" id="screening-edit" name="screening_passed">
                    <label for="screening-edit" style="margin: 0; text-transform: none;">Screening Passed</label>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn btn-ghost" onclick="closeEdit()">Cancel</button>
                <button type="submit" class="btn btn-brand">Save Changes</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<script>
function openCreate() { document.getElementById('modal-create').classList.add('open'); }
function closeCreate(){ document.getElementById('modal-create').classList.remove('open'); }
function openEdit(donation) {
    const f = document.getElementById('edit-form');
    f.action = '/dashboard/donations/' + donation.donation_id + '/edit';
    // Show donor full name
    const donorName = (donation.donor_first_name ?? '') + ' ' + (donation.donor_last_name ?? '');
    document.getElementById('edit-donor').value = donorName.trim();
    document.getElementById('edit-blood-type').value = donation.blood_type_id ?? '';
    document.getElementById('edit-event').value = donation.donation_event_id ?? '';
    document.getElementById('edit-hospital').value = donation.hospital_id ?? '';
    document.getElementById('edit-units').value = donation.units_collected ?? 0;
    document.getElementById('edit-volume').value = donation.volume_collected ?? '';
    document.getElementById('edit-status').value = donation.status ?? 'COMPLETED';
    document.getElementById('edit-notes').value = donation.medical_notes ?? '';
    document.getElementById('screening-edit').checked = donation.screening_passed == 1;
    
    // Convert date format
    if (donation.donation_date) {
        const dateStr = donation.donation_date.replace(' ','T').substring(0,16);
        document.getElementById('edit-date').value = dateStr;
    }
    
    document.getElementById('modal-edit').classList.add('open');
}
function closeEdit(){ document.getElementById('modal-edit').classList.remove('open'); }

// Close modal on backdrop click
document.querySelectorAll('.modal-bg').forEach(bg => {
    bg.addEventListener('click', e => { if (e.target === bg) bg.classList.remove('open'); });
});
</script>
{% endblock %}
