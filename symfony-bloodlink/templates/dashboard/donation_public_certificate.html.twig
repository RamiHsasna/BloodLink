<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donation Certificate | BloodLink</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #8f1d1f;
            --brand-light: #b3272a;
            --gold: #d4af37;
            --ink: #0f172a;
            --subtle: #64748b;
            --bg: #f8fafc;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            color: var(--ink);
        }

        .certificate-container {
            width: 100%;
            max-width: 500px;
            padding: 20px;
        }

        .certificate {
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }

        .cert-header {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            padding: 40px 30px;
            text-align: center;
            color: #fff;
            position: relative;
        }

        .cert-header::after {
            content: '';
            position: absolute;
            bottom: -20px;
            left: 0;
            right: 0;
            height: 40px;
            background: #fff;
            clip-path: ellipse(50% 100% at 50% 100%);
        }

        .logo {
            font-weight: 800;
            font-size: 24px;
            letter-spacing: -1px;
            margin-bottom: 8px;
            display: block;
        }

        .cert-title {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            opacity: 0.9;
            font-weight: 400;
        }

        .cert-body {
            padding: 40px 30px 30px;
            text-align: center;
        }

        .donor-name {
            font-size: 32px;
            font-weight: 800;
            margin: 10px 0;
            color: var(--ink);
            background: linear-gradient(135deg, var(--ink), var(--brand));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .cert-desc {
            font-size: 16px;
            color: var(--subtle);
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .blood-type-badge {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100px;
            height: 100px;
            background: #fff1f2;
            border: 2px solid var(--brand);
            border-radius: 50%;
            margin: 0 auto 25px;
            box-shadow: 0 10px 20px rgba(143, 29, 31, 0.1);
        }

        .blood-code {
            font-size: 32px;
            font-weight: 800;
            color: var(--brand);
            line-height: 1;
        }

        .blood-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--brand);
            font-weight: 600;
            margin-top: 4px;
        }

        .cert-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
            padding-top: 25px;
            border-top: 1px dashed #e2e8f0;
        }

        .detail-item {
            text-align: left;
        }

        .detail-label {
            font-size: 11px;
            color: var(--subtle);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .detail-value {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .verified-seal {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            opacity: 0.2;
            pointer-events: none;
        }

        .btn-container {
            margin-top: 30px;
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-family: inherit;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--brand);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--brand-light);
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(143, 29, 31, 0.2);
        }

        .btn-outline {
            background: #fff;
            color: var(--ink);
            border: 1px solid #e2e8f0;
        }

        .btn-outline:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
        }

        @media (max-width: 480px) {
            .donor-name { font-size: 28px; }
            .cert-details { grid-template-columns: 1fr; }
        }

        /* Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .certificate {
            animation: fadeIn 0.8s ease-out;
        }
    </style>
</head>
<body>

<div class="certificate-container">
    <div class="certificate" id="certificate-card">
        <div class="cert-header">
            <span class="logo">BloodLink</span>
            <span class="cert-title">Donation Certificate</span>
            
            <svg class="verified-seal" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
        </div>

        <div class="cert-body">
            <div class="blood-type-badge">
                <span class="blood-code">{{ donation.blood_code }}</span>
                <span class="blood-label">Type</span>
            </div>

            <span class="cert-desc">This is to certify that</span>
            <div class="donor-name">{{ donation.donor_name }}</div>
            <span class="cert-desc">has successfully donated blood and contributed to saving lives through our network.</span>

            <div class="cert-details">
                <div class="detail-item">
                    <div class="detail-label">Donation Date</div>
                    <div class="detail-value">{{ donation.donation_date|date('F d, Y') }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Location</div>
                    <div class="detail-value">{{ donation.hospital_name ?: 'Mobile Unit' }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Donation ID</div>
                    <div class="detail-value" style="font-family: monospace; font-size: 11px;">{{ donation.donation_id|slice(0, 8) }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Status</div>
                    <div class="detail-value" style="color: #16a34a;">Verified ✓</div>
                </div>
            </div>
        </div>
    </div>

    <div class="btn-container">
        <button class="btn btn-primary" onclick="downloadImage()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            Save as Image
        </button>
        <a href="/" class="btn btn-outline">Back to BloodLink</a>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
    function downloadImage() {
        const cert = document.getElementById('certificate-card');
        const btn = event.currentTarget;
        const originalText = btn.innerHTML;
        
        btn.innerHTML = 'Generating...';
        btn.disabled = true;

        html2canvas(cert, {
            scale: 2,
            backgroundColor: '#f8fafc',
            logging: false,
            useCORS: true
        }).then(canvas => {
            const link = document.createElement('a');
            link.download = 'bloodlink-certificate-{{ donation.donation_id|slice(0, 8) }}.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
            
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    }
</script>

</body>
</html>
