            userType.value = btn.dataset.userType || 'DONOR';
            document.getElementById('m_blood_type_id').value = btn.dataset.donorBloodTypeId || '';
            document.getElementById('m_last_donation_date').value = btn.dataset.donorLastDonationDate || '';
            document.getElementById('m_donor_city').value = btn.dataset.donorCity || '';
            document.getElementById('m_total_donations').value = btn.dataset.donorTotalDonations || '0';

            document.getElementById('m_staff_role').value = btn.dataset.staffRole || '';
            document.getElementById('m_hospital_id').value = btn.dataset.staffHospitalId || '';
            document.getElementById('m_department').value = btn.dataset.staffDepartment || '';

            toggleTypeSections();
        }

        openAddBtn.addEventListener('click', function () {
            resetForCreate();
            openModal();
        });

        function bindUserListInteractions() {
            document.querySelectorAll('.open-edit-user').forEach(function (btn) {
                if (btn.dataset.boundEdit === '1') {
                    return;
                }

                btn.dataset.boundEdit = '1';
                btn.addEventListener('click', function () {
                    fillForEdit(btn);
                    openModal();
                });
            });

            document.querySelectorAll('.open-user-details').forEach(function (card) {
                if (card.dataset.boundDetails === '1') {
                    return;
                }

                card.dataset.boundDetails = '1';
                card.addEventListener('click', function (e) {
                    if (e.target.closest('.crud-bar')) {
                        return;
                    }
                    openDetailsModal(card);
                });

                card.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        openDetailsModal(card);
                    }
                });
            });

            document.querySelectorAll('.crud-bar').forEach(function (bar) {
                if (bar.dataset.boundCrud === '1') {
                    return;
                }

                bar.dataset.boundCrud = '1';
                bar.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            });
        }

        bindUserListInteractions();

        closeBtn.addEventListener('click', closeModal);
        cancelBtn.addEventListener('click', closeModal);
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) {
                closeModal();
            }
        });

        detailsCloseBtn.addEventListener('click', closeDetailsModal);
        detailsCloseFooterBtn.addEventListener('click', closeDetailsModal);
        detailsOverlay.addEventListener('click', function (e) {
            if (e.target === detailsOverlay) {
                closeDetailsModal();
            }
        });

        userType.addEventListener('change', toggleTypeSections);
        toggleTypeSections();
    })();
</script>
{% endblock %}
