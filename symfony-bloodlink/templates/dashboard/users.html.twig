        function openModal() {
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
        }

        function closeModal() {
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
        }

        function safeValue(value) {
            return value && value.trim() !== '' ? value : 'N/A';
        }

        function openDetailsModal(card) {
            detailFields.name.textContent = ((card.dataset.firstName || '') + ' ' + (card.dataset.lastName || '')).trim() || 'N/A';
            detailFields.userType.textContent = safeValue(card.dataset.userType);
            detailFields.email.textContent = safeValue(card.dataset.email);
            detailFields.phone.textContent = safeValue(card.dataset.phone);
            detailFields.userId.textContent = safeValue(card.dataset.userId);
            detailFields.createdAt.textContent = safeValue(card.dataset.createdAt);
            detailFields.bloodType.textContent = safeValue(card.dataset.donorBloodTypeId);
            detailFields.lastDonation.textContent = safeValue(card.dataset.donorLastDonationDate);
            detailFields.city.textContent = safeValue(card.dataset.donorCity);
            detailFields.totalDonations.textContent = safeValue(card.dataset.donorTotalDonations);
            detailFields.staffRole.textContent = safeValue(card.dataset.staffRole);
            detailFields.staffHospital.textContent = safeValue(card.dataset.staffHospitalId);
            detailFields.staffDepartment.textContent = safeValue(card.dataset.staffDepartment);

            detailsOverlay.classList.add('open');
            detailsOverlay.setAttribute('aria-hidden', 'false');
        }

        function closeDetailsModal() {
            detailsOverlay.classList.remove('open');
            detailsOverlay.setAttribute('aria-hidden', 'true');
        }

