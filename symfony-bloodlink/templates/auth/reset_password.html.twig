{% extends 'base.html.twig' %}
{% set body_class = 'auth-page' %}

{% block title %}Reset Password - BloodLink{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/auth-shell.css') }}">
{% endblock %}

{% block body %}
    <div class="auth-shell">
        <section class="auth-panel" style="width: 100%; max-width: 500px; margin: 0 auto; display: flex; align-items: center; justify-content: center; height: 100vh;">
            <div class="auth-card" style="width: 100%;">
                <div class="auth-brand" style="margin-bottom: 2rem; justify-content: center;">
                    <div>
                        <p class="auth-brand-name" style="text-align: center;">BloodLink</p>
                        <p class="auth-brand-subtitle" style="text-align: center;">Choose a new password</p>
                    </div>
                </div>

                {% include 'shared/_flash.html.twig' %}

                <div class="pane active">
                    <h2 class="auth-title">Reset Password</h2>
                    <p class="auth-sub">Please enter and confirm your new password below.</p>

                    <form method="post" data-turbo="false">
                        <div class="auth-field">
                            <label for="password">New Password</label>
                            <input
                                id="password"
                                type="password"
                                name="password"
                                required
                                autocomplete="new-password"
                                placeholder="Minimum 8 characters"
                                style="width: 100%;"
                            >
                        </div>

                        <div class="auth-field" style="margin-top: 1rem;">
                            <label for="confirm_password">Confirm New Password</label>
                            <input
                                id="confirm_password"
                                type="password"
                                name="confirm_password"
                                required
                                autocomplete="new-password"
                                placeholder="Repeat your new password"
                                style="width: 100%;"
                            >
                        </div>

                        <div class="actions" style="margin-top: 2rem;">
                            <button type="submit" class="btn" style="width: 100%;">Update Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
