{% extends 'base.html.twig' %}
{% set body_class = 'auth-page' %}

{% block title %}Forgot Password - BloodLink{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/auth-shell.css') }}">
{% endblock %}

{% block body %}
    <div class="auth-shell">
        <section class="auth-panel" style="width: 100%; max-width: 500px; margin: 0 auto; display: flex; align-items: center; justify-content: center; height: 100vh;">
            <div class="auth-card" style="width: 100%;">
                <div class="auth-brand" style="margin-bottom: 2rem; justify-content: center;">
                    <div>
                        <p class="auth-brand-name" style="text-align: center;">BloodLink</p>
                        <p class="auth-brand-subtitle" style="text-align: center;">Reset your password</p>
                    </div>
                </div>

                {% include 'shared/_flash.html.twig' %}

                <div class="pane active">
                    <h2 class="auth-title">Forgot Password?</h2>
                    <p class="auth-sub">Enter your email address and we'll send you a link to reset your password.</p>

                    <form method="post" data-turbo="false">
                        <div class="auth-field">
                            <label for="email">Email address</label>
                            <input
                                id="email"
                                type="email"
                                name="email"
                                required
                                autocomplete="email"
                                placeholder="name@example.com"
                                style="width: 100%;"
                            >
                        </div>

                        <div class="actions" style="margin-top: 2rem;">
                            <button type="submit" class="btn" style="width: 100%;">Send Reset Link</button>
                        </div>

                        <div class="switch-row" style="margin-top: 1.5rem; justify-content: center;">
                            <a href="{{ path('auth_index') }}" class="switch-link">Back to Sign in</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
