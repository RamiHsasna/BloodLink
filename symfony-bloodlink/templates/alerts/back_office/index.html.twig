{% set page_title = 'Donor Alerts' %}
{% set page_description = 'Back Office workspace for donor notifications, with scoped search, delivery status, and response filters.' %}
{% extends 'alerts/layouts/back_office.html.twig' %}

{% block page_actions %}
    <div class="flex flex-wrap gap-3">
        <a
            href="{{ path('dashboard_alerts_create_blood_alert') }}"
            class="inline-flex items-center justify-center rounded-2xl bg-blood-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blood-700"
        >
            🩸 Create Blood Alert
        </a>
    </div>
{% endblock %}

{% block module_content %}
    <form method="get" action="{{ path('dashboard_alerts_index') }}" class="audit-filter-card">
        <div class="audit-filter-head">
            <div>
                <p class="audit-filter-kicker">Refine results</p>
                <p class="audit-filter-copy">Focus the alert list by title, recipient, response state, and delivery progress.</p>
            </div>
        </div>

        <div class="audit-filter-grid">
            <label class="audit-filter-field audit-filter-field--search">
                <span class="audit-filter-label">Search</span>
                <input type="text" name="q" value="{{ filters.query }}" placeholder="Title, donor, response..." class="audit-filter-input">
            </label>

            <label class="audit-filter-field">
                <span class="audit-filter-label">Start date</span>
                <input type="date" name="start" value="{{ filters.start }}" class="audit-filter-input">
            </label>

            <label class="audit-filter-field">
                <span class="audit-filter-label">End date</span>
                <input type="date" name="end" value="{{ filters.end }}" class="audit-filter-input">
            </label>

            <label class="audit-filter-field">
                <span class="audit-filter-label">Response</span>
                <select name="response" class="audit-filter-input">
                    <option value="">All responses</option>
                    {% for label, value in response_choices %}
                        <option value="{{ value }}" {{ filters.response == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="audit-filter-field">
                <span class="audit-filter-label">Delivery state</span>
                <select name="delivery" class="audit-filter-input">
                    <option value="">All delivery states</option>
                    {% for label, value in delivery_choices %}
                        <option value="{{ value }}" {{ filters.delivery == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        <div class="audit-filter-actions">
            <button type="submit" class="audit-filter-submit">Apply filters</button>
            <a href="{{ path('dashboard_alerts_index') }}" class="audit-filter-reset">Reset</a>
        </div>
    </form>

    <div class="mt-6 overflow-hidden rounded-3xl border border-slate-200 bg-white">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr class="text-left text-xs font-bold uppercase tracking-[0.18em] text-slate-500">
                        <th class="px-5 py-4">Alert</th>
                        <th class="px-5 py-4">Donor</th>
                        <th class="px-5 py-4">Delivery</th>
                        <th class="px-5 py-4">Response</th>
                        <th class="px-5 py-4">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for entry in entries %}
                        <tr class="align-top text-sm text-slate-600">
                            <td class="px-5 py-4">
                                <p class="font-bold text-slate-950">{{ entry.alert ? entry.alert.title : 'Missing alert' }}</p>
                                <p class="mt-1 text-xs text-slate-500">{{ entry.alert ? entry.alert.severity : 'N/A' }}</p>
                                <p class="mt-2 text-xs text-slate-500">#{{ entry.donorAlertId|slice(0, 8) }}</p>
                            </td>
                            <td class="px-5 py-4">
                                <p class="font-semibold text-slate-900">
                                    {{ entry.donor ? entry.donor.firstName ~ ' ' ~ entry.donor.lastName : 'Unknown donor' }}
                                </p>
                                <p class="mt-1 text-xs text-slate-500">{{ entry.donor and entry.donor.user ? entry.donor.user.email : 'No email' }}</p>
                            </td>
                            <td class="px-5 py-4">
                                <div class="space-y-2 text-xs font-semibold">
                                    <span class="inline-flex rounded-full px-3 py-1 {{ entry.isNotified ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' }}">
                                        {{ entry.isNotified ? 'Notified' : 'Pending delivery' }}
                                    </span>
                                    <span class="inline-flex rounded-full px-3 py-1 {{ entry.isRead ? 'bg-blood-50 text-blood-700' : 'bg-slate-100 text-slate-600' }}">
                                        {{ entry.isRead ? 'Read by donor' : 'Unread' }}
                                    </span>
                                    <p class="text-slate-500">Sent: {{ entry.notificationSentAt ? entry.notificationSentAt|date('Y-m-d H:i') : 'N/A' }}</p>
                                </div>
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-flex rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">
                                    {{ entry.donorResponse ?: 'NO_RESPONSE' }}
                                </span>
                                <p class="mt-2 text-xs text-slate-500">Read at: {{ entry.readAt ? entry.readAt|date('Y-m-d H:i') : 'N/A' }}</p>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap gap-2">
                                    <a href="{{ path('dashboard_alerts_show', {donorAlertId: entry.donorAlertId}) }}" class="rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">View</a>
                                    {% if entry.alert %}
                                        <a href="{{ path('dashboard_alerts_edit_blood_alert', {alertId: entry.alert.alertId}) }}" class="rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">Edit</a>
                                    {% endif %}
                                    <form method="post" action="{{ path('dashboard_alerts_delete', {donorAlertId: entry.donorAlertId}) }}" data-confirm-message="Delete this donor alert?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-donor-alert-' ~ entry.donorAlertId) }}">
                                        <button type="submit" class="rounded-xl border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-600 transition hover:border-rose-400 hover:bg-rose-50">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-5 py-12 text-center text-sm text-slate-500">No donor alerts match the current filters.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include 'log_management/partials/_pagination.html.twig' with {pagination: result, route_name: 'dashboard_alerts_index', extra_query: {q: filters.query, start: filters.start, end: filters.end, response: filters.response, delivery: filters.delivery}} %}
{% endblock %}
