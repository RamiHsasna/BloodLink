{% set page_title = 'Alerts' %}
{% set page_description = 'Read-only donor-facing alert timeline and response state.' %}
{% extends 'alerts/layouts/front_office.html.twig' %}

{% block module_content %}
    <div class="grid gap-4 lg:grid-cols-3">
        <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Total alerts</p>
            <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{{ summary.total }}</p>
            <p class="mt-2 text-sm text-slate-500">All donor notifications visible to your account.</p>
        </article>
        <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Unread</p>
            <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{{ summary.unread }}</p>
            <p class="mt-2 text-sm text-slate-500">Notifications that still need your attention.</p>
        </article>
        <article class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Timeline focus</p>
            <p class="mt-3 text-xl font-extrabold tracking-tight text-slate-950">Read only</p>
            <p class="mt-2 text-sm text-slate-500">This front-office view stays donor-friendly and never exposes admin CRUD actions.</p>
        </article>
    </div>

    <form method="get" action="{{ path('dashboard_donor_alerts') }}" class="mt-6 grid gap-3 rounded-3xl border border-slate-200 bg-slate-50 p-4 lg:grid-cols-[minmax(0,1fr)_120px]">
        <input type="text" name="q" value="{{ query }}" placeholder="Search title, severity, response..." class="w-full rounded-2xl border-slate-300">
        <button type="submit" class="rounded-2xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white">Apply</button>
    </form>

    <div class="mt-6 space-y-4">
        {% for entry in entries %}
            <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-soft">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div class="flex gap-4">
                        <div class="mt-1 h-3 w-3 rounded-full {{ entry.isRead ? 'bg-emerald-500' : 'bg-blood-500' }}"></div>
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blood-600">{{ entry.alert ? entry.alert.severity : 'Alert' }}</p>
                            <h2 class="mt-1 text-xl font-extrabold tracking-tight text-slate-950">{{ entry.alert ? entry.alert.title : 'Untitled alert' }}</h2>
                            <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">{{ entry.alert ? entry.alert.message : 'No alert message was attached.' }}</p>
                            <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700">{{ entry.isNotified ? 'Notification sent' : 'Pending notification' }}</span>
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700">{{ entry.isRead ? 'Read' : 'Unread' }}</span>
                                <span class="rounded-full bg-blood-50 px-3 py-1 text-blood-700">{{ entry.donorResponse ?: 'NO_RESPONSE' }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2 text-sm text-slate-500 lg:text-right">
                        <p>Sent: {{ entry.notificationSentAt ? entry.notificationSentAt|date('Y-m-d H:i') : 'N/A' }}</p>
                        <p>Read: {{ entry.readAt ? entry.readAt|date('Y-m-d H:i') : 'N/A' }}</p>
                        <a href="{{ path('dashboard_donor_alert_show', {donorAlertId: entry.donorAlertId}) }}" class="inline-flex rounded-2xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">Open detail</a>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-4 py-12 text-center text-sm text-slate-500">
                No donor alerts match the current search.
            </div>
        {% endfor %}
    </div>

    {% include 'log_management/partials/_pagination.html.twig' with {pagination: result, route_name: 'dashboard_donor_alerts', extra_query: {q: query}} %}
{% endblock %}
