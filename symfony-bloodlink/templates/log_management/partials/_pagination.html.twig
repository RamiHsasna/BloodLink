{% if pagination.pages > 1 %}
    {% set route_name = route_name|default(app.request.attributes.get('_route')) %}
    {% set current_query = app.request.query.all|merge(extra_query|default({})) %}
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-4">
        <p class="text-sm text-slate-500">
            Page <span class="font-semibold text-slate-900">{{ pagination.page }}</span> of
            <span class="font-semibold text-slate-900">{{ pagination.pages }}</span>
        </p>

        <div class="flex items-center gap-2">
            {% if pagination.page > 1 %}
                <a
                    href="{{ path(route_name, current_query|merge({page: pagination.page - 1})) }}"
                    class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600"
                >
                    Previous
                </a>
            {% endif %}

            {% for page_number in 1..pagination.pages %}
                {% if page_number == pagination.page %}
                    <span class="rounded-xl bg-blood-600 px-3 py-2 text-sm font-semibold text-white">{{ page_number }}</span>
                {% elseif page_number >= pagination.page - 1 and page_number <= pagination.page + 1 %}
                    <a
                        href="{{ path(route_name, current_query|merge({page: page_number})) }}"
                        class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600"
                    >
                        {{ page_number }}
                    </a>
                {% endif %}
            {% endfor %}

            {% if pagination.page < pagination.pages %}
                <a
                    href="{{ path(route_name, current_query|merge({page: pagination.page + 1})) }}"
                    class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600"
                >
                    Next
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}
