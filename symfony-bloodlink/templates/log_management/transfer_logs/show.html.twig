{% set page_title = 'Transfer Log Detail' %}
{% set page_description = 'Inspect the full transfer trace, including the hospital relation and the status movement stored in the log row.' %}
{% extends 'log_management/layouts/back_office.html.twig' %}

{% block page_actions %}
    <div class="flex flex-wrap gap-3">
        <a href="{{ path('dashboard_logs_transfers_export_pdf', {logId: entry.logId}) }}" class="inline-flex items-center justify-center rounded-2xl bg-slate-800 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-900" style="color:#ffffff;">Export PDF</a>
        <a href="{{ path('dashboard_logs_transfers_edit', {logId: entry.logId}) }}" class="inline-flex items-center justify-center rounded-2xl bg-blood-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blood-700">Edit</a>
        <form method="post" action="{{ path('dashboard_logs_transfers_delete', {logId: entry.logId}) }}" data-confirm-message="Delete this transfer log?">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-transfer-log-' ~ entry.logId) }}">
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-rose-200 px-4 py-3 text-sm font-semibold text-rose-600 transition hover:border-rose-400 hover:bg-rose-50">Delete</button>
        </form>
        <a href="{{ path('dashboard_logs_transfers') }}" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-blood-500 hover:text-blood-600">Back</a>
    </div>
{% endblock %}

{% block module_content %}
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
        <section class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
            <div class="grid gap-5 md:grid-cols-2">
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Action</p>
                    <p class="mt-3 text-2xl font-extrabold text-slate-950">{{ entry.action }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Created at</p>
                    <p class="mt-3 text-lg font-bold text-slate-950">{{ entry.createdAt ? entry.createdAt|date('Y-m-d H:i') : 'N/A' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 md:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Status transition</p>
                    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm font-semibold">
                        <span class="rounded-full bg-slate-100 px-4 py-2 text-slate-700">{{ entry.previousStatus ?: 'N/A' }}</span>
                        <span class="text-blood-600">→</span>
                        <span class="rounded-full bg-blood-50 px-4 py-2 text-blood-700">{{ entry.newStatus ?: 'N/A' }}</span>
                    </div>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Transfer relation</p>
                    <p class="mt-3 text-base font-bold text-slate-950">#{{ entry.bloodTransferRequest ? entry.bloodTransferRequest.transferId : 'Missing relation' }}</p>
                    <p class="mt-1 text-sm text-slate-500">
                        {{ entry.bloodTransferRequest and entry.bloodTransferRequest.requestingHospital ? entry.bloodTransferRequest.requestingHospital.name : 'Unknown' }}
                        →
                        {{ entry.bloodTransferRequest and entry.bloodTransferRequest.approvingHospital ? entry.bloodTransferRequest.approvingHospital.name : 'Pending' }}
                    </p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Actor relation</p>
                    <p class="mt-3 text-base font-bold text-slate-950">
                        {{ entry.user ? entry.user.firstName ~ ' ' ~ entry.user.lastName : 'Missing relation' }}
                    </p>
                    <p class="mt-1 text-sm text-slate-500">{{ entry.user ? entry.user.userType : 'No actor attached' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 md:col-span-2">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Notes</p>
                    <p id="notes-content-{{ entry.logId }}" class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-600">{{ entry.notes ?: 'No notes were stored for this log.' }}</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 md:col-span-2">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blood-600">AI anomaly review</p>
                            <p class="mt-2 text-sm text-slate-500">Structured review generated from the saved server-side audit payload.</p>
                        </div>
                        {% if entry.anomalyDetected %}
                            <span class="audit-anomaly-badge audit-anomaly-badge--{{ entry.anomalySeverity|default('medium') }}">
                                {{ entry.anomalySeverity|default('medium')|capitalize }} · {{ entry.anomalyScore|default(0) }}/100
                            </span>
                        {% else %}
                            <span class="audit-anomaly-badge audit-anomaly-badge--none">Normal</span>
                        {% endif %}
                    </div>

                    {% if entry.anomalyDetected %}
                        <div class="audit-anomaly-panel mt-4">
                            <p class="text-sm font-semibold text-slate-950">{{ entry.anomalyExplanation ?: 'Anomaly detected for review.' }}</p>
                            <p class="mt-2 text-sm text-slate-600">{{ entry.anomalyRecommendedAction ?: 'Review the linked transfer request and actor attribution.' }}</p>

                            {% if entry.anomalyReasons %}
                                <ul class="mt-4 grid gap-2 text-sm text-slate-600">
                                    {% for reason in entry.anomalyReasons %}
                                        <li class="audit-anomaly-reason">{{ reason }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                            <div class="mt-4 grid gap-3 text-xs font-semibold text-slate-500 sm:grid-cols-3">
                                <p>Provider: {{ entry.anomalyAnalysisProvider ?: 'rules' }}</p>
                                <p>SMS: {{ entry.smsAlertStatus ?: 'not required' }}</p>
                                <p>Review: {{ entry.anomalyReviewed ? 'reviewed' : 'pending' }}</p>
                            </div>

                            {% if entry.smsAlertError %}
                                <p class="mt-3 rounded-xl bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-700">{{ entry.smsAlertError }}</p>
                            {% endif %}

                            {% if not entry.anomalyReviewed %}
                                <form method="post" action="{{ path('dashboard_logs_transfers_review_anomaly', {logId: entry.logId}) }}" class="mt-4">
                                    <input type="hidden" name="_token" value="{{ csrf_token('review-transfer-anomaly-' ~ entry.logId) }}">
                                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">Mark reviewed</button>
                                </form>
                            {% else %}
                                <p class="mt-4 text-sm text-emerald-700">
                                    Reviewed {{ entry.anomalyReviewedAt ? entry.anomalyReviewedAt|date('Y-m-d H:i') : '' }}
                                    {% if entry.anomalyReviewedBy %}by {{ entry.anomalyReviewedBy.firstName }} {{ entry.anomalyReviewedBy.lastName }}{% endif %}
                                </p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="audit-anomaly-panel mt-4">
                            <p class="text-sm font-semibold text-slate-950">No anomaly signals detected.</p>
                            <p class="mt-2 text-sm text-slate-600">{{ entry.anomalyExplanation ?: 'This log passed the configured audit checks.' }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6">
            {% if qr_code is defined and qr_code %}
                <div class="mb-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-center">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-blood-600">Audit QR code</p>
                    <img src="{{ qr_code }}" alt="Transfer log QR code" class="mx-auto mt-3 h-44 w-44">
                    <p class="mt-2 text-xs text-slate-500">Scan with any QR reader to display the full log details offline.</p>
                </div>
            {% endif %}
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blood-600">Linked records</p>
            <dl class="mt-4 space-y-4 text-sm text-slate-600">
                <div>
                    <dt class="font-semibold text-slate-900">Audit entry</dt>
                    <dd class="mt-1 font-semibold text-slate-950">{{ entry.action }} · {{ entry.createdAt ? entry.createdAt|date('Y-m-d H:i') : 'No timestamp' }}</dd>
                    <dd class="mt-1 break-all text-xs text-slate-500">Log UUID: {{ entry.logId }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Transfer request</dt>
                    <dd class="mt-1 font-semibold text-slate-950">
                        {% if entry.bloodTransferRequest %}
                            Request #{{ entry.bloodTransferRequest.transferId }}
                        {% else %}
                            Missing relation
                        {% endif %}
                    </dd>
                    <dd class="mt-1 text-xs text-slate-500">
                        {% if entry.bloodTransferRequest %}
                            {{ entry.bloodTransferRequest.requestingHospital ? entry.bloodTransferRequest.requestingHospital.name : 'Unknown hospital' }}
                            →
                            {{ entry.bloodTransferRequest.approvingHospital ? entry.bloodTransferRequest.approvingHospital.name : 'Pending hospital' }}
                        {% else %}
                            No transfer request is attached to this log.
                        {% endif %}
                    </dd>
                    <dd class="mt-1 break-all text-xs text-slate-500">Transfer ID: {{ entry.bloodTransferRequest ? entry.bloodTransferRequest.transferId : 'N/A' }}</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-900">Logged by</dt>
                    <dd class="mt-1 font-semibold text-slate-950">{{ entry.user ? entry.user.firstName ~ ' ' ~ entry.user.lastName : 'Missing relation' }}</dd>
                    <dd class="mt-1 text-xs text-slate-500">{{ entry.user ? entry.user.userType : 'No actor attached' }}</dd>
                    <dd class="mt-1 break-all text-xs text-slate-500">Actor UUID: {{ entry.user ? entry.user.userId : 'N/A' }}</dd>
                </div>
            </dl>
        </aside>
    </div>
{% endblock %}
