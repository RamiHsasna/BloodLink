<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.edu.esprit.controllers.DonationsChartController"
      spacing="20" prefWidth="700" prefHeight="500"
      style="-fx-background-color: white; -fx-padding: 30;">

    <Label text="📊 Donations Per Month"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2535;"/>

    <Label text="Total number of donations recorded each month"
           style="-fx-font-size: 13px; -fx-text-fill: #6b7c93;"/>

    <BarChart fx:id="donationsChart" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
        <xAxis>
            <CategoryAxis label="Month"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Donations"/>
        </yAxis>
    </BarChart>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" onAction="#handleClose"
                style="-fx-background-color: #e53935; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 8;
                       -fx-padding: 8 24 8 24; -fx-cursor: hand;"/>
    </HBox>

</VBox>