<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.edu.esprit.controllers.DonationEventDialogController"
      styleClass="dialog-container" spacing="15" prefWidth="500" prefHeight="750">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <!-- Header -->
    <VBox spacing="5">
        <Label text="Add Donation Event" styleClass="dialog-title"/>
        <Label text="Register a new blood donation event in the BloodLink network." styleClass="dialog-subtitle"/>
    </VBox>

    <!-- Form -->
    <ScrollPane fitToWidth="true" styleClass="form-scroll">
        <VBox spacing="12">
            <!-- Hospital ID -->
            <VBox spacing="5">
                <Label text="Hospital" styleClass="form-label"/>
                <ComboBox fx:id="hospitalIdCombo" promptText="Select Hospital" styleClass="form-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Event Name -->
            <VBox spacing="5">
                <Label text="Event Name" styleClass="form-label"/>
                <TextField fx:id="nameField" promptText="Enter event name" styleClass="form-field"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="5">
                <Label text="Description" styleClass="form-label"/>
                <TextArea fx:id="descriptionField" promptText="Enter event description" wrapText="true" prefRowCount="3" styleClass="form-field"/>
            </VBox>

            <!-- Start Date -->
            <VBox spacing="5">
                <Label text="Start Date" styleClass="form-label"/>
                <DatePicker fx:id="startDatePicker" styleClass="form-field"/>
            </VBox>

            <!-- End Date -->
            <VBox spacing="5">
                <Label text="End Date" styleClass="form-label"/>
                <DatePicker fx:id="endDatePicker" styleClass="form-field"/>
            </VBox>

            <!-- Location -->
            <VBox spacing="5">
                <Label text="Location" styleClass="form-label"/>
                <TextField fx:id="locationField" promptText="Enter event location" styleClass="form-field"/>
            </VBox>

            <!-- Target Blood Types -->
            <VBox spacing="5">
                <Label text="Target Blood Types" styleClass="form-label"/>
                <TextField fx:id="targetBloodTypesField" promptText="E.g., O+, O-, A+, A-, B+, B-, AB+, AB-" styleClass="form-field"/>
            </VBox>

            <!-- Target Collection Units -->
            <VBox spacing="5">
                <Label text="Target Collection Units" styleClass="form-label"/>
                <TextField fx:id="targetCollectionUnitsField" promptText="Number of units" styleClass="form-field"/>
            </VBox>

            <!-- Status -->
            <VBox spacing="5">
                <Label text="Status" styleClass="form-label"/>
                <ComboBox fx:id="statusCombo" promptText="Select Status" styleClass="form-field" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Error Label -->
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;"/>

    <!-- Action Buttons -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" styleClass="btn-cancel" onAction="#handleCancel">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
        </Button>
        <Button fx:id="saveBtn" text="Save" styleClass="btn-primary" onAction="#handleSave">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
        </Button>
    </HBox>

</VBox>
